import { Link, useLocation } from 'react-router-dom';
import { useEffect, useState } from 'react';
import {
  BookOpen,
  Menu,
  X,
} from 'lucide-react';

export default function Navbar() {
  const location = useLocation();

  const [scrolled, setScrolled] = useState(false);
  const [mobileOpen, setMobileOpen] = useState(false);

  useEffect(() => {
    const handleScroll = () => {
      setScrolled(window.scrollY > 24);
    };

    window.addEventListener('scroll', handleScroll);

    return () => {
      window.removeEventListener('scroll', handleScroll);
    };
  }, []);

  useEffect(() => {
    setMobileOpen(false);
  }, [location.pathname]);

  const links = [
    { to: '/', label: 'Home' },
    { to: '/books', label: 'Books' },
    { to: '/add', label: 'Add Book' },
    { to: '/scan', label: 'Scan' },
    { to: '/dashboard', label: 'Dashboard' },
  ];

  return (
    <header
      className={`fixed top-0 left-0 right-0 z-[90] transition-all duration-500 ${
        scrolled
          ? 'bg-slate-950/75 backdrop-blur-2xl border-b border-white/[0.07] shadow-xl shadow-black/10'
          : 'bg-slate-950/25 backdrop-blur-md'
      }`}
    >
      <div className="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

        <Link
          to="/"
          className="group flex items-center gap-3"
        >
          <div className="relative p-2.5 rounded-xl bg-gradient-to-br from-purple-500/20 to-cyan-500/10 border border-white/10 group-hover:border-purple-400/40 transition-all duration-300">
            <BookOpen className="w-5 h-5 text-purple-300" />
          </div>

          <span className="text-xl font-black tracking-tight bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent">
            NexLib
          </span>
        </Link>

        {/* Desktop navigation */}
        <nav className="hidden md:flex items-center gap-1">
          {links.map((link) => {
            const active = location.pathname === link.to;

            return (
              <Link
                key={link.to}
                to={link.to}
                className={`relative px-4 py-2.5 rounded-full text-sm font-medium transition-all duration-300 ${
                  active
                    ? 'text-white bg-white/[0.07]'
                    : 'text-slate-400 hover:text-white hover:bg-white/[0.04]'
                }`}
              >
                {link.label}

                {active && (
                  <span className="absolute left-1/2 bottom-1 -translate-x-1/2 w-6 h-0.5 rounded-full bg-gradient-to-r from-purple-400 to-cyan-400" />
                )}
