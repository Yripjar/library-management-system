/* =========================================================
   INTERACTIVE LANDING
========================================================= */

.scroll-video-hero {
  position: relative;
  width: 100%;
  height: 280vh;
  background: #080907;
}

.scroll-video-hero__sticky {
  position: sticky;
  top: 0;
  height: 100vh;
  width: 100%;
  overflow: hidden;
  isolation: isolate;
}

.scroll-video-hero__video {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: -3;

  filter:
    brightness(.62)
    contrast(1.08)
    saturate(.9);

  pointer-events: none;

  transform: scale(1.01);
}

.scroll-video-hero__overlay {
  position: absolute;
  inset: 0;

  z-index: -2;

  background:
    linear-gradient(
      90deg,
      rgba(5,7,5,.88),
      rgba(5,7,5,.48) 42%,
      rgba(5,7,5,.10) 75%,
      rgba(5,7,5,.45)
    ),
    linear-gradient(
      180deg,
      rgba(5,7,5,.62),
      transparent 38%,
      rgba(5,7,5,.82)
    );
}

.scroll-video-hero__grain {
  position: absolute;
  inset: 0;

  z-index: -1;

  pointer-events: none;

  opacity: .075;

  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
}

.scroll-video-hero__top {
  position: absolute;

  top: 0;
  left: 0;
  right: 0;

  padding:
    100px
    clamp(20px,5vw,70px)
    0;

  display: flex;

  justify-content: space-between;
}

.scroll-video-hero__content {
  position: absolute;

  left:
    clamp(20px,5vw,70px);

  bottom: 115px;

  width:
    min(850px,75vw);
}

.scroll-video-hero__kicker {
