              </p>
            </div>

            <div className="grid md:grid-cols-2 gap-x-12 gap-y-5 mt-8">

              {categories.length === 0 && (
                <p className="text-slate-600">
                  Add books to see category data.
                </p>
              )}

              {categories.map(
                ([category, count]) => {
                  const percentage =
                    books.length > 0
                      ? (count /
                          books.length) *
                        100
                      : 0;

                  return (
                    <div key={category}>

                      <div className="flex justify-between mb-2">
                        <span className="text-sm text-slate-300">
                          {category}
                        </span>

                        <span className="text-sm text-slate-600">
                          {count}
                        </span>
                      </div>

                      <div className="h-2 rounded-full bg-white/[0.05] overflow-hidden">
                        <div
                          className="h-full rounded-full bg-gradient-to-r from-purple-500 to-cyan-400"
                          style={{
                            width: `${percentage}%`,
                          }}
                        />
                      </div>

                    </div>
                  );
                }
              )}
            </div>
          </div>

          {/* Transactions */}
          <div className="mt-6 rounded-3xl border border-white/[0.08] bg-white/[0.035] backdrop-blur-xl overflow-hidden">

            <div className="p-7 border-b border-white/[0.06]">

              <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

                <div>
                  <h2 className="text-2xl font-bold">
                    Transaction History
                  </h2>

                  <p className="mt-1 text-sm text-slate-600">
                    Search and filter all borrowing activity.
                  </p>
                </div>

                <div className="flex flex-col sm:flex-row gap-3">

                  <div className="relative">
                    <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-600" />

                    <input
                      value={search}
                      onChange={(e) =>
                        setSearch(e.target.value)
                      }
                      placeholder="Search borrower or book"
                      className="w-full sm:w-64 bg-white/[0.04] border border-white/10 rounded-xl pl-10 pr-4 py-3 text-white placeholder-slate-600 outline-none focus:border-purple-500/50"
                    />
                  </div>

                  <select
                    value={statusFilter}
                    onChange={(e) =>
                      setStatusFilter(
                        e.target.value
                      )
                    }
                    className="bg-slate-900 border border-white/10 rounded-xl px-4 py-3 text-white"
                  >
                    <option value="">
                      All statuses
                    </option>
                    <option value="issued">
                      Issued
                    </option>
                    <option value="returned">
                      Returned
                    </option>
                  </select>

                </div>
              </div>
            </div>

            <div className="overflow-x-auto">

              <table className="w-full text-left">

                <thead className="bg-white/[0.025] text-slate-600 text-sm">
                  <tr>
                    <th className="px-7 py-4">
                      Book
                    </th>

                    <th className="px-7 py-4">
                      Borrower
                    </th>

                    <th className="px-7 py-4">
                      Issue Date
                    </th>

                    <th className="px-7 py-4">
                      Status
                    </th>

                    <th className="px-7 py-4">
                      Due
                    </th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-white/[0.05]">

                  {filteredTransactions
                    .slice(0, 20)
                    .map((transaction) => {

                      const overdue =
                        transaction.status ===
                          'issued' &&
                        transaction.dueDate &&
                        new Date(
                          transaction.dueDate
                        ) < new Date();

                      return (
                        <tr
                          key={
                            transaction._id
                          }
                          className="hover:bg-white/[0.025] transition-colors"
                        >

                          <td className="px-7 py-5">
                            <p className="font-medium text-white">
                              {transaction
                                .book?.title ||
                                'Unknown book'}
                            </p>

                            <p className="text-xs text-slate-600 mt-1">
                              {transaction
                                .book?.author ||
                                ''}
                            </p>
                          </td>

                          <td className="px-7 py-5 text-slate-300">
                            <span className="inline-flex items-center gap-2">
                              <User className="w-4 h-4 text-slate-600" />
                              {
                                transaction.borrowerName
                              }
                            </span>
                          </td>

                          <td className="px-7 py-5 text-slate-400">
                            <span className="inline-flex items-center gap-2">
                              <Calendar className="w-4 h-4 text-slate-600" />

                              {transaction.issueTimestamp
                                ? new Date(
                                    transaction.issueTimestamp
                                  ).toLocaleDateString()
                                : '-'}
                            </span>
                          </td>

                          <td className="px-7 py-5">

                            <span
                              className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs ${
                                transaction.status ===
                                'issued'
                                  ? 'bg-yellow-500/10 text-yellow-300 border border-yellow-500/20'
                                  : 'bg-emerald-500/10 text-emerald-300 border border-emerald-500/20'
                              }`}
                            >
                              <BadgeCheck className="w-3 h-3" />

                              {
                                transaction.status
                              }
                            </span>

                          </td>

                          <td className="px-7 py-5">

                            {transaction.dueDate ? (
                              <span
                                className={
                                  overdue
                                    ? 'text-red-400'
                                    : 'text-slate-400'
                                }
                              >
                                {overdue && (
                                  <AlertTriangle className="inline w-3.5 h-3.5 mr-1" />
                                )}

                                {new Date(
                                  transaction.dueDate
                                ).toLocaleDateString()}
                              </span>
                            ) : (
                              '-'
                            )}

                          </td>

                        </tr>
                      );
                    })}

                  {filteredTransactions.length === 0 && (
                    <tr>
                      <td
                        colSpan={5}
                        className="px-7 py-16 text-center text-slate-600"
                      >
                        No matching transactions.
                      </td>
                    </tr>
                  )}

                </tbody>
              </table>
            </div>
          </div>

          {/* Quick actions */}
          <div className="grid md:grid-cols-3 gap-4 mt-6">

            <QuickAction
              icon={BookOpen}
              title="Manage Books"
              description="Search, edit and manage inventory."
              to="/books"
            />

            <QuickAction
              icon={ArrowUpRight}
              title="Issue / Return"
              description="Scan a book and update its status."
              to="/scan"
            />

            <QuickAction
              icon={Library}
              title="Add Collection"
              description="Add a new title to your library."
              to="/add"
            />

          </div>
        </>
      )}
    </div>
  );
}

function StatCard({
  label,
  value,
  icon: Icon,
  refCallback,
  theme,
}) {
  const themes = {
    purple:
      'from-purple-500/15 to-purple-500/[0.02] text-purple-400',

    cyan:
      'from-cyan-500/15 to-cyan-500/[0.02] text-cyan-400',

    green:
      'from-emerald-500/15 to-emerald-500/[0.02] text-emerald-400',

    red:
      'from-red-500/15 to-red-500/[0.02] text-red-400',
  };

  return (
    <div
      className={`relative overflow-hidden rounded-3xl border border-white/[0.08] bg-gradient-to-br ${themes[theme]} p-6 backdrop-blur-xl`}
    >
      <div className="relative">

        <div className="inline-flex p-3 rounded-xl bg-white/[0.05]">
          <Icon className="w-6 h-6" />
        </div>

        <p className="mt-5 text-sm text-slate-500">
          {label}
        </p>

        <div
          ref={refCallback}
          className="mt-2 text-4xl font-black text-white"
        >
          {value}
        </div>

      </div>
    </div>
  );
}

function MiniMetric({ label, value }) {
  return (
    <div className="rounded-2xl bg-white/[0.03] border border-white/[0.06] p-4">
      <p className="text-xs text-slate-600">
        {label}
      </p>

      <p className="mt-2 text-2xl font-bold">
        {value}
      </p>
    </div>
  );
}

function QuickAction({
  icon: Icon,
  title,
  description,
  to,
}) {
  return (
    <a
      href={to}
      className="group rounded-2xl border border-white/[0.08] bg-white/[0.035] p-5 hover:-translate-y-1 hover:border-purple-500/30 transition-all"
    >
      <div className="p-3 w-fit rounded-xl bg-purple-500/10 text-purple-400">
        <Icon />
      </div>

      <h3 className="mt-5 font-bold">
        {title}
      </h3>

      <p className="mt-1 text-sm text-slate-600">
        {description}
      </p>
    </a>
  );
}
