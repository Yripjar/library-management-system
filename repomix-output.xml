import { useEffect, useRef } from 'react';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

/**
 * useGSAP hook - reuse animation logic.
 * Provide a function that receives a gsap context.
 */
export function useGSAP(buildAnimation, deps = []) {
  const ref = useRef(null);

  useEffect(() => {
    const ctx = gsap.context(() => {
      buildAnimation(gsap, ScrollTrigger);
    }, ref);

    return () => ctx.revert();
  }, deps);

  return ref;
}
</file>

<file path="client/src/hooks/useGSAPTimeline.js">
import { useRef, useEffect } from 'react';
import gsap from 'gsap';

export function useGSAPTimeline(buildTimeline) {
  const timelineRef = useRef(null);

  useEffect(() => {
    if (timelineRef.current) timelineRef.current.kill();
    timelineRef.current = gsap.timeline();
    buildTimeline(timelineRef.current);
    return () => timelineRef.current?.kill();
  }, [buildTimeline]);

  return timelineRef;
}
</file>

