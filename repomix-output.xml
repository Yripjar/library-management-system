  pointer-events: none;
}

.interactive-book__glow {
  position: absolute;

  width: 180px;
  height: 180px;

  transform:
    translate(-50%,-50%);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(210,255,74,.18),
      transparent 65%
    );

  pointer-events: none;

  transition:
    left .08s linear,
    top .08s linear;
}

