                    ...editingBook,
                    title: value,
                  })
                }
              />

              <EditInput
                label="Author"
                value={editingBook.author}
                onChange={(value) =>
                  setEditingBook({
                    ...editingBook,
                    author: value,
                  })
                }
              />

              <EditInput
                label="ISBN / Book ID"
                value={editingBook.isbn}
                onChange={(value) =>
                  setEditingBook({
                    ...editingBook,
                    isbn: value,
                  })
                }
              />

              <EditInput
                label="Category"
                value={editingBook.category}
                onChange={(value) =>
                  setEditingBook({
                    ...editingBook,
                    category: value,
                  })
                }
              />

              <EditInput
                label="Total Copies"
                type="number"
                min="1"
                value={editingBook.totalCopies}
                onChange={(value) =>
                  setEditingBook({
                    ...editingBook,
                    totalCopies: value,
                  })
                }
              />

              <button
                type="submit"
                disabled={saving}
                className="w-full py-3.5 rounded-xl bg-gradient-to-r from-purple-500 to-cyan-500 font-semibold disabled:opacity-50"
              >
                {saving
                  ? 'Saving...'
                  : 'Save Changes'}
              </button>

            </form>

          </div>
        </div>
      )}

    </div>
  );
}

function EditInput({
  label,
  type = 'text',
  value,
  onChange,
  min,
}) {
  return (
    <div>
      <label className="block text-sm text-slate-500 mb-2">
        {label}
      </label>

      <input
        type={type}
        min={min}
        value={value}
        onChange={(event) =>
          onChange(event.target.value)
        }
        className="w-full rounded-xl bg-white/[0.04] border border-white/10 px-4 py-3 text-white outline-none focus:border-purple-500/50"
      />
    </div>
  );
}
