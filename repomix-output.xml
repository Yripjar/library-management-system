  background: var(--signal);
  padding: 15px 18px;
}

.landing-footer .mono {
  color: var(--muted);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

/* DASHBOARD */

.workspace-page {
  padding: 118px clamp(20px,4vw,56px) 70px;
  min-height: 100vh;
  background: var(--ink);
}

.workspace-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--line);
}

.workspace-header h1 {
  font-size: clamp(52px,6.5vw,95px);
  margin-bottom: 0;
}

.workspace-actions {
  display: flex;
  gap: 15px;
  padding-bottom: 9px;
}

.utility-link {
  border: 0;
  background: none;
  color: var(--muted);
  display: flex;
  gap: 8px;
  align-items: center;
  padding: 9px 0;
  cursor: pointer;
}

.utility-link:hover {
  color: var(--paper);
}

.utility-link--solid {
  color: var(--signal);
  border-bottom: 1px solid var(--signal);
}

.workspace-error {
  margin: 16px 0;
  color: var(--danger);
  font-size: 13px;
}

.workspace-loading {
  min-height: 60vh;
  display: grid;
  place-content: center;
  gap: 14px;
  color: var(--muted);
}

.loading-line {
  width: 180px;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--signal),
    transparent
  );
  animation: loading 1.6s linear infinite;
}

@keyframes loading {
  from {
    transform: translateX(-45%);
  }

  to {
    transform: translateX(45%);
  }
}

.workspace-grid {
  display: grid;
  grid-template-columns: minmax(0,1.6fr) minmax(260px,.58fr);
  gap: 24px;
  padding-top: 24px;
}

.workspace-map {
  min-width: 0;
}

.workspace-map__head {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding-bottom: 15px;
  align-items: flex-end;
}

.workspace-map__head h2,
.transaction-strip__head h2 {
  margin: 9px 0 0;
  font: 500 27px var(--serif);
}

.workspace-map__readout {
  display: grid;
  gap: 3px;
  text-align: right;
}

.workspace-map__readout strong {
  font: 500 28px var(--serif);
  color: var(--signal);
}

.workspace-map .network-field {
  min-height: 610px;
}

.workspace-map__footer {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
}

.context-rail {
  border-left: 1px solid var(--line);
}

.rail-block {
  padding: 20px 0 24px 24px;
  border-bottom: 1px solid var(--line);
}

.rail-block--primary {
  min-height: 240px;
}

.rail-block h2 {
  font: 500 35px/.95 var(--serif);
  margin: 12px 0 5px;
}

.rail-block p {
  color: var(--muted);
  margin: 0;
  font-size: 13px;
  line-height: 1.5;
}

.rail-dl {
  margin: 25px 0 20px;
}

.rail-dl div {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 9px 0;
  border-top: 1px solid var(--line);
}

.rail-dl dt {
  color: var(--muted);
  letter-spacing: .08em;
}

.rail-dl dd {
  margin: 0;
  text-align: right;
  font-size: 12px;
}

.signal-text {
  color: var(--signal) !important;
}

.rail-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--paper);
  font-size: 12px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 4px;
}

.rail-empty {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-top: 28px;
}

.rail-empty__mark {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border: 1px solid var(--line);
  color: var(--signal);
}

.readout-stack {
  display: grid;
  gap: 13px;
  margin-top: 18px;
}

.readout-stack div {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid var(--line);
  padding-top: 9px;
}

.readout-stack span {
  color: var(--muted);
  font-size: 12px;
}

.readout-stack strong {
  font: 500 22px var(--serif);
}

.activity-bars {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 130px;
  margin-top: 15px;
}

.activity-bar {
  flex: 1;
  height: 100%;
  display: grid;
  grid-template-rows: 1fr auto auto;
  align-items: end;
  gap: 4px;
  text-align: center;
}

.activity-bar span {
  width: 100%;
  background: var(--signal);
  opacity: .75;
  min-height: 3px;
  align-self: end;
}

.activity-bar small {
  font: 9px var(--mono);
  color: var(--paper-dim);
}

.activity-bar label {
  letter-spacing: .04em;
  font-size: 8px;
  color: var(--muted);
}

.transaction-strip {
  grid-column: 1/-1;
  border-top: 1px solid var(--line);
  padding-top: 24px;
  margin-top: 4px;
}

.transaction-strip__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  padding-bottom: 14px;
}

.transaction-filters {
  display: flex;
  gap: 12px;
  align-items: center;
}

.search-line {
  display: flex;
  align-items: center;
  gap: 7px;
  border-bottom: 1px solid var(--line);
  padding: 8px 0;
  color: var(--muted);
}

.search-line input {
  width: 210px;
  background: none;
  border: 0;
  outline: 0;
  color: var(--paper);
  font-size: 12px;
}

.transaction-filters select {
  background: var(--ink);
  color: var(--paper);
  border: 0;
  border-bottom: 1px solid var(--line);
  padding: 8px 0;
  outline: none;
}

.transaction-table {
  border-top: 1px solid var(--line);
}

.transaction-row {
  display: grid;
  grid-template-columns: 1.6fr 1fr .7fr .55fr;
  gap: 20px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  font-size: 12px;
}

.transaction-row--head {
  color: var(--muted);
  padding-top: 12px;
}

.transaction-empty {
  padding: 28px 0;
  color: var(--muted);
  font-size: 13px;
}

/* TABLET */

@media (max-width: 1100px) {
  .hero-instrument {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto auto;
    padding-top: 105px;
  }

  .hero-instrument__visual {
    min-height: 500px;
    order: 3;
  }

  .hero-instrument__copy {
    padding-bottom: 0;
  }

  .hero-instrument__readout {
    margin: 0;
    border-left: 0;
    border-top: 1px solid var(--line);
    padding: 18px 0 0;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 22px;
  }

  .readout-rule {
    display: none;
  }

  .readout-facts {
    grid-template-columns: repeat(3,1fr);
    grid-column: 1/-1;
  }

  .hero-instrument__scroll {
    order: 5;
  }

  .workspace-grid {
    grid-template-columns: 1fr;
  }

  .context-rail {
    border-left: 0;
    display: grid;
    grid-template-columns: 1.1fr .9fr .9fr;
  }

  .rail-block {
    padding-left: 0;
    padding-right: 24px;
    border-bottom: 0;
  }

  .rail-block + .rail-block {
    border-left: 1px solid var(--line);
    padding-left: 20px;
  }
}

/* MOBILE */

@media (max-width: 760px) {
  .site-nav__links,
  .nav-add {
    display: none;
  }

  .nav-menu {
    display: block;
  }

  .site-nav__mobile {
    display: flex;
    flex-direction: column;
    padding: 9px 20px 18px;
    border-top: 1px solid var(--line);
    background: var(--ink);
  }

  .site-nav__mobile a {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .site-nav__mobile a.is-active {
    color: var(--signal);
  }

  .hero-instrument {
    padding-top: 96px;
  }

  .hero-instrument__meta {
    gap: 20px;
  }

  .hero-instrument__meta .mono {
    text-align: right;
  }

  .hero-instrument__copy h1 {
    font-size: clamp(52px,17vw,78px);
  }

  .hero-instrument__visual {
    min-height: 420px;
  }

  .network-field {
    min-height: 420px;
  }

  .network-node__label {
    display: none;
  }

  .hero-instrument__readout {
    grid-template-columns: 1fr;
  }

  .readout-facts {
    grid-template-columns: repeat(3,1fr);
  }

  .readout-facts strong {
    font-size: 18px;
  }

  .editorial-section,
  .editorial-section--evidence {
    grid-template-columns: 1fr;
    gap: 26px;
    padding: 90px 22px;
  }

  .editorial-section .section-index {
    order: -1;
  }

  .story-band {
    grid-template-columns: 1fr;
  }

  .story-band__visual {
    min-height: 480px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .story-band__copy {
    padding: 80px 22px;
  }

  .evidence-ruler {
    grid-template-columns: 1fr;
  }

  .evidence-ruler div,
  .evidence-ruler div + div {
    border-left: 0;
    border-top: 1px solid var(--line);
    padding: 18px 0;
  }

  .landing-footer {
    flex-direction: column;
    padding: 90px 22px 40px;
  }

  .workspace-page {
    padding: 98px 18px 50px;
  }

  .workspace-header {
    flex-direction: column;
    align-items: flex-start;
  }

  .workspace-header h1 {
    font-size: clamp(48px,16vw,72px);
  }

  .workspace-actions {
    width: 100%;
    justify-content: space-between;
  }

  .workspace-map .network-field {
    min-height: 470px;
  }

  .workspace-map__footer {
    flex-direction: column;
    gap: 6px;
  }

  .context-rail {
    grid-template-columns: 1fr;
  }

  .rail-block,
  .rail-block + .rail-block {
    border-left: 0;
    border-bottom: 1px solid var(--line);
    padding: 20px 0 24px;
  }

  .transaction-strip__head {
    flex-direction: column;
    align-items: flex-start;
  }

  .transaction-filters {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }

  .search-line input {
    flex: 1;
    width: auto;
    min-width: 0;
  }

  .transaction-row {
    grid-template-columns: 1fr .8fr;
  }

  .transaction-row span:nth-child(3),
  .transaction-row span:nth-child(4),
  .transaction-row--head span:nth-child(3),
  .transaction-row--head span:nth-child(4) {
    display: none;
  }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
    scroll-behavior: auto !important;
  }
}
.hero-instrument__visual {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.hero-video {
  position: absolute;
  inset: 0;
  z-index: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  opacity: .42;

  filter:
    grayscale(.12)
    contrast(1.08)
    brightness(.62);

  pointer-events: none;
}

.hero-video__scrim {
  position: absolute;
  inset: 0;
  z-index: 1;

  background:
    linear-gradient(
      90deg,
      rgba(16,17,15,.72),
      rgba(16,17,15,.08) 48%,
      rgba(16,17,15,.44)
    ),
    linear-gradient(
      180deg,
      rgba(16,17,15,.15),
      rgba(16,17,15,.62)
    );

  pointer-events: none;
}

.hero-instrument__visual > .network-field {
  position: absolute;
  inset: 0;
  z-index: 2;

  border: 0;
  background: transparent;
}

.hero-instrument__legend {
  z-index: 5;
}

@media (prefers-reduced-motion: reduce) {
  .hero-video {
    display: none;
  }
}
/* =========================================================
   SCANNER PAGE
========================================================= */

.tool-page {
  min-height: 100vh;
  padding: 118px clamp(20px, 5vw, 72px) 80px;
  background:
    radial-gradient(
      circle at 72% 22%,
      rgba(210, 255, 74, .045),
      transparent 30%
    ),
    var(--ink);
}

.tool-intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 50px;

  padding-bottom: 28px;

  border-bottom: 1px solid var(--line);
}

.tool-intro h1 {
  margin: 12px 0 18px;

  font: 500 clamp(54px, 7vw, 100px)/.88 var(--serif);

  letter-spacing: -.055em;
}

.tool-intro h1 em {
  color: var(--signal);
  font-style: italic;
}

.tool-intro__lede {
  max-width: 570px;

  margin: 0;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.75;
}

.tool-intro__meta {
  display: flex;
  align-items: flex-end;
  flex-direction: column;

  gap: 17px;

  padding-bottom: 5px;

  white-space: nowrap;
}

/* -------------------------
   WORKSPACE
-------------------------- */

.scanner-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(290px, .55fr);

  min-height: 650px;

  border-bottom: 1px solid var(--line);
}

.scanner-stage {
  min-width: 0;

  padding: 24px 24px 28px 0;
}

.scanner-stage__topline {
  display: flex;
  justify-content: space-between;

  padding-bottom: 14px;

  color: var(--muted);

  border-bottom: 1px solid var(--line);
}

/* -------------------------
   CAMERA VIEW
-------------------------- */

.scanner-viewport {
  position: relative;

  min-height: 510px;

  margin-top: 20px;

  overflow: hidden;

  display: grid;
  place-items: center;

  background:
    linear-gradient(
      rgba(210, 255, 74, .02) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(210, 255, 74, .02) 1px,
      transparent 1px
    ),
    #0d0e0c;

  background-size: 44px 44px;

  border: 1px solid var(--line);
}

.scanner-viewport::before {
  content: "";

  position: absolute;
  inset: 12%;

  border: 1px solid rgba(241,238,231,.08);

  pointer-events: none;
}

.scanner-viewport::after {
  content: "";

  position: absolute;

  left: 12%;
  right: 12%;
  top: 50%;

  height: 1px;

  background: var(--line);

  pointer-events: none;
}

.scanner-placeholder {
  position: relative;
  z-index: 3;

  width: min(430px, 80%);

  text-align: center;
}

.scanner-placeholder__target {
  width: 250px;
  height: 250px;

  margin: 0 auto 30px;

  display: grid;
  place-items: center;

  color: var(--signal);

  border:
    1px solid rgba(210,255,74,.32);

  box-shadow:
    inset 0 0 60px rgba(210,255,74,.025);
}

.scanner-placeholder__target::before {
  content: "";

  position: absolute;

  width: 294px;
  height: 294px;

  border: 1px solid rgba(210,255,74,.08);
}

.scanner-placeholder h2 {
  margin: 12px 0 10px;

  font: 500 37px/.98 var(--serif);

  letter-spacing: -.04em;
}

.scanner-placeholder p {
  margin: 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.6;
}

#qr-reader {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  z-index: 4;
}

#qr-reader video {
  width: 100% !important;
  height: 100% !important;

  object-fit: cover;
}

#qr-reader img {
  display: none;
}

#qr-reader__dashboard {
  position: absolute !important;

  left: 50% !important;
  bottom: 18px !important;

  transform: translateX(-50%);

  z-index: 12;

  width: min(500px, 90%) !important;

  padding: 10px !important;

  background: rgba(16,17,15,.86) !important;

  border: 1px solid var(--line) !important;

  color: var(--paper) !important;
}

#qr-reader__dashboard button {
  border: 0;

  background: none;

  color: var(--signal);

  cursor: pointer;
}

#qr-reader__dashboard select {
  background: var(--ink);
  color: var(--paper);
}

/* scanner corners */

.scanner-placeholder__target {
  position: relative;
}

.scanner-placeholder__target::after {
  content: "";

  position: absolute;

  inset: 0;

  border: 1px solid var(--signal);

  clip-path: polygon(
    0 0,
    18% 0,
    18% 3px,
    3px 3px,
    3px 18%,
    0 18%,

    82% 0,
    100% 0,
    100% 18%,
    calc(100% - 3px) 18%,
    calc(100% - 3px) 3px,
    82% 3px,

    0 82%,
    3px 82%,
    3px calc(100% - 3px),
    18% calc(100% - 3px),
    18% 100%,
    0 100%,

    82% 100%,
    100% 100%,
    100% 82%,
    calc(100% - 3px) 82%,
    calc(100% - 3px) calc(100% - 3px),
    82% calc(100% - 3px)
  );
}

.scanner-beam {
  position: absolute;

  left: 17%;
  right: 17%;

  top: 20%;

  height: 1px;

  z-index: 7;

  background: var(--signal);

  box-shadow:
    0 0 22px rgba(210,255,74,.7);

  animation:
    scanner-beam 2.8s ease-in-out infinite;
}

@keyframes scanner-beam {
  0% {
    transform: translateY(0);
    opacity: .35;
  }

  50% {
    transform: translateY(300px);
    opacity: 1;
  }

  100% {
    transform: translateY(0);
    opacity: .35;
  }
}

/* -------------------------
   CONTROLS
-------------------------- */

.scanner-controls {
  display: flex;

  align-items: center;

  gap: 18px;

  padding-top: 20px;
}

.control-link {
  min-height: 43px;

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding: 0 15px;

  border: 1px solid var(--line);

  background: none;

  color: var(--paper);

  cursor: pointer;
}

.control-link:hover {
  border-color: var(--signal);
  color: var(--signal);
}

.control-link--signal {
  border-color: var(--signal);
  color: var(--signal);
}

.manual-code {
  flex: 1;

  min-width: 0;

  display: flex;

  border-bottom: 1px solid var(--line);
}

.manual-code input {
  width: 100%;

  min-width: 0;

  padding: 11px 0;

  border: 0;
  outline: 0;

  background: transparent;

  color: var(--paper);
}

.manual-code input::placeholder {
  color: #66675f;
}

.manual-code button {
  width: 42px;

  border: 0;

  background: none;

  color: var(--signal);

  cursor: pointer;
}

/* -------------------------
   RAIL
-------------------------- */

.scanner-rail {
  border-left: 1px solid var(--line);

  padding-left: 26px;
}

.scanner-rail__section {
  padding: 25px 0 28px;

  border-bottom: 1px solid var(--line);
}

.scanner-rail__section:last-child {
  border-bottom: 0;
}

.mode-switch {
  display: grid;

  grid-template-columns: 1fr 1fr;

  margin-top: 18px;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.mode-switch button {
  padding: 13px 0;

  border: 0;

  background: none;

  color: var(--muted);

  cursor: pointer;

  text-transform: uppercase;

  font-family: var(--mono);

  font-size: 10px;

  letter-spacing: .12em;
}

.mode-switch button + button {
  border-left: 1px solid var(--line);
}

.mode-switch button:hover,
.mode-switch button.is-active {
  color: var(--signal);
}

.field-line {
  display: grid;

  gap: 9px;

  margin-top: 24px;
}

.field-line span {
  color: var(--muted);

  font-family: var(--mono);

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .14em;
}

.field-line input {
  width: 100%;

  padding: 13px 0;

  border: 0;

  border-bottom: 1px solid var(--line);

  outline: 0;

  background: none;

  color: var(--paper);
}

.field-line input:focus {
  border-color: var(--signal);
}

.scanner-muted {
  max-width: 300px;

  margin: 18px 0 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.65;
}

.result-block {
  display: flex;

  align-items: flex-start;

  gap: 12px;

  margin-top: 20px;

  padding: 17px;

  border-left: 2px solid var(--line);
}

.result-block p {
  margin: 0;

  font-size: 13px;

  line-height: 1.55;
}

.result-block--success {
  color: var(--signal);
  border-color: var(--signal);
}

.result-block--error {
  color: var(--danger);
  border-color: var(--danger);
}

.last-code {
  display: grid;

  gap: 8px;

  margin-top: 18px;

  padding-top: 15px;

  border-top: 1px solid var(--line);
}

.last-code code {
  overflow-wrap: anywhere;

  color: var(--paper-dim);

  font-family: var(--mono);

  font-size: 10px;

  line-height: 1.5;
}

.shortcut-copy {
  display: grid;

  gap: 13px;

  margin-top: 18px;
}

.shortcut-copy span {
  display: flex;

  gap: 10px;

  align-items: center;

  color: var(--muted);

  font-size: 12px;
}

.shortcut-copy kbd {
  min-width: 28px;

  padding: 4px 5px;

  border: 1px solid var(--line);

  color: var(--signal);

  font-family: var(--mono);

  font-size: 8px;

  text-align: center;
}

/* -------------------------
   RESPONSIVE
-------------------------- */

@media (max-width: 960px) {
  .scanner-workspace {
    grid-template-columns: 1fr;
  }

  .scanner-rail {
    border-left: 0;

    border-top: 1px solid var(--line);

    padding-left: 0;

    display: grid;

    grid-template-columns:
      repeat(2, 1fr);
  }

  .scanner-rail__section {
    padding-right: 24px;
  }

  .scanner-rail__section:nth-child(2n) {
    border-left: 1px solid var(--line);

    padding-left: 24px;
  }

  .scanner-rail__section:last-child {
    grid-column: 1 / -1;
    border-left: 0;
    padding-left: 0;
  }
}

@media (max-width: 720px) {
  .tool-page {
    padding:
      96px
      18px
      55px;
  }

  .tool-intro {
    display: block;
  }

  .tool-intro__meta {
    margin-top: 25px;

    align-items: flex-start;
  }

  .scanner-stage {
    padding-right: 0;
  }

  .scanner-viewport {
    min-height: 420px;
  }

  .scanner-controls {
    flex-direction: column;

    align-items: stretch;
  }

  .scanner-rail {
    display: block;
  }

  .scanner-rail__section,
  .scanner-rail__section:nth-child(2n),
  .scanner-rail__section:last-child {
    border-left: 0;

    padding-left: 0;
    padding-right: 0;
  }

  .scanner-placeholder__target {
    width: 210px;
    height: 210px;
  }
}
/* =========================================================
   ADD BOOK — RECORD STUDIO
========================================================= */

.add-book-page {
  min-height: 100vh;

  padding:
    120px
    clamp(20px, 6vw, 90px)
    90px;

  background:
    radial-gradient(
      circle at 16% 18%,
      rgba(255, 174, 96, .055),
      transparent 24%
    ),
    var(--ink);
}

.add-book-header {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    220px;

  gap: 60px;

  padding-bottom: 42px;

  border-bottom: 1px solid var(--line);
}

.add-book-kicker {
  color: var(--signal);

  font-family: var(--mono);
  font-size: 10px;

  letter-spacing: .18em;
}

.add-book-header h1 {
  margin: 18px 0 20px;

  font:
    500 clamp(58px, 8vw, 110px)/.82
    var(--serif);

  letter-spacing: -.065em;
}

.add-book-header h1 em {
  color: var(--paper-dim);
}

.add-book-header p {
  max-width: 550px;

  margin: 0;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.7;
}

.add-book-header__side {
  align-self: end;

  display: grid;

  gap: 16px;
}

.add-book-header__side span {
  display: flex;

  justify-content: space-between;

  padding-top: 10px;

  border-top: 1px solid var(--line);

  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .14em;
}

.add-book-header__side strong {
  color: var(--paper);

  font-weight: 400;
}

/* layout */

.add-book-layout {
  display: grid;

  grid-template-columns:
    minmax(260px, .65fr)
    minmax(0, 1.35fr);

  gap: clamp(40px, 8vw, 120px);

  padding-top: 45px;
}

/* preview */

.add-book-preview {
  position: sticky;

  top: 120px;

  align-self: start;

  min-height: 540px;
}

.preview-index {
  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .16em;
}

.book-object {
  position: relative;

  width: min(260px, 78%);

  height: 370px;

  margin:
    55px
    auto
    55px 10%;

  transform: rotate(-4deg);
}

.book-object__spine {
  position: absolute;

  left: -11px;
  top: 0;
  bottom: 0;

  width: 18px;

  background:
    linear-gradient(
      90deg,
      #20221d,
      #10110f
    );

  border-left:
    1px solid
    rgba(241,238,231,.14);

  border-radius:
    2px 0 0 2px;
}

.book-object__cover {
  position: absolute;

  inset: 0;

  padding: 25px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(210,255,74,.25),
      transparent 28%
    ),
    #272b22;

  border:
    1px solid
    rgba(241,238,231,.15);

  box-shadow:
    22px 25px 60px
    rgba(0,0,0,.3);
}

.book-object__symbol {
  display: grid;

  place-items: center;

  width: 45px;
  height: 45px;

  color: var(--signal);

  border:
    1px solid
    rgba(210,255,74,.35);
}

.book-object__category {
  align-self: flex-end;

  color: var(--muted);

  font:
    8px
    var(--mono);

  letter-spacing: .14em;
}

.book-object strong {
  display: block;

  max-width: 190px;

  font:
    500
    clamp(32px, 3vw, 45px)/.9
    var(--serif);

  letter-spacing: -.04em;
}

.book-object small {
  color: var(--paper-dim);

  font-size: 12px;
}

.book-object__lines {
  display: flex;

  gap: 5px;
}

.book-object__lines i {
  display: block;

  height: 2px;

  background: var(--signal);

  opacity: .65;
}

.book-object__lines i:nth-child(1) {
  width: 48px;
}

.book-object__lines i:nth-child(2) {
  width: 27px;
  opacity: .35;
}

.book-object__lines i:nth-child(3) {
  width: 12px;
  opacity: .2;
}

.preview-note {
  display: grid;

  grid-template-columns:
    65px
    1fr;

  gap: 15px;

  padding-top: 20px;

  border-top: 1px solid var(--line);

  max-width: 380px;

  margin-left: 10%;
}

.preview-note > span {
  color: var(--signal);

  font:
    8px
    var(--mono);

  letter-spacing: .13em;
}

.preview-note p {
  margin: 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.5;
}

/* form */

.add-book-form-wrap {
  min-width: 0;
}

.form-heading {
  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  padding-bottom: 20px;

  border-bottom: 1px solid var(--line);
}

.form-heading span {
  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .16em;
}

.form-heading h2 {
  margin: 9px 0 0;

  font:
    500 35px
    var(--serif);

  letter-spacing: -.04em;
}

.form-heading > svg {
  color: var(--signal);
}

.add-book-form {
  display: grid;

  gap: 27px;

  padding-top: 28px;
}

.form-grid {
  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 22px;
}

.form-field {
  position: relative;

  min-width: 0;
}

.form-field label {
  display: flex;

  align-items: center;

  gap: 9px;

  margin-bottom: 9px;

  color: var(--paper);

  font-size: 12px;
}

.form-field label span {
  color: var(--muted);

  font:
    8px
    var(--mono);
}

.form-field input,
.form-field select {
  width: 100%;

  min-height: 52px;

  padding:
    0 14px;

  border: 0;

  border-bottom:
    1px solid var(--line);

  outline: none;

  background:
    rgba(241,238,231,.025);

  color: var(--paper);

  font-size: 14px;

  transition:
    background .2s,
    border-color .2s;
}

.form-field input:focus,
.form-field select:focus {
  background:
    rgba(210,255,74,.035);

  border-color:
    var(--signal);
}

.form-field input::placeholder {
  color: #5e6058;
}

.form-field select {
  appearance: none;

  cursor: pointer;
}

.form-field select option {
  background: #141511;

  color: var(--paper);
}

.form-field small {
  display: block;

  margin-top: 7px;

  color: var(--danger);

  font-size: 11px;
}

.number-control {
  display: grid;

  grid-template-columns:
    48px
    1fr
    48px;

  border-bottom:
    1px solid var(--line);
}

.number-control input {
  border: 0;

  text-align: center;

  background:
    rgba(241,238,231,.025);
}

.number-control button {
  border: 0;

  background: none;

  color: var(--muted);

  cursor: pointer;

  font-size: 19px;
}

.number-control button:hover {
  color: var(--signal);
}

.form-status {
  display: grid;

  grid-template-columns:
    auto
    1fr;

  gap: 13px;

  padding: 17px;

  border-left: 2px solid;
}

.form-status strong {
  display: block;

  margin-bottom: 5px;

  font: 500 17px var(--serif);
}

.form-status p {
  margin: 0;

  color: var(--muted);

  font-size: 12px;
  line-height: 1.5;
}

.form-status code {
  display: inline-block;

  margin-top: 10px;

  padding: 5px 7px;

  background:
    rgba(241,238,231,.035);

  color: var(--signal);

  font:
    9px
    var(--mono);

  overflow-wrap: anywhere;
}

.form-status--error {
  color: var(--danger);

  border-color: var(--danger);

  background:
    rgba(255,177,143,.025);
}

.form-status--success {
  color: var(--signal);

  border-color: var(--signal);

  background:
    rgba(210,255,74,.025);
}

.form-actions {
  display: flex;

  justify-content: flex-end;

  gap: 22px;

  padding-top: 10px;

  border-top: 1px solid var(--line);
}

.form-secondary,
.form-submit {
  min-height: 50px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 9px;

  padding:
    0 18px;
}

.form-secondary {
  color: var(--muted);
}

.form-secondary:hover {
  color: var(--paper);
}

.form-submit {
  border: 1px solid var(--signal);

  background: var(--signal);

  color: var(--signal-ink);

  cursor: pointer;

  font-size: 13px;
  font-weight: 600;
}

.form-submit:hover {
  background: var(--paper);

  border-color: var(--paper);
}

.form-submit:disabled {
  opacity: .5;

  cursor: wait;
}

.after-success {
  display: flex;

  gap: 22px;

  margin-top: 17px;
}

.after-success button {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  padding: 0;

  border: 0;

  border-bottom:
    1px solid var(--line);

  background: none;

  color: var(--muted);

  cursor: pointer;

  font-size: 12px;
}

.after-success button:hover {
  color: var(--signal);

  border-color: var(--signal);
}

@media (max-width: 900px) {
  .add-book-layout {
    grid-template-columns: 1fr;
  }

  .add-book-preview {
    position: static;

    min-height: auto;

    padding-bottom: 20px;
  }

  .book-object {
    margin-left: 5%;
  }

  .preview-note {
    margin-left: 5%;
  }
}

@media (max-width: 650px) {
  .add-book-page {
    padding:
      98px
      18px
      60px;
  }

  .add-book-header {
    grid-template-columns: 1fr;
  }

  .add-book-header__side {
    grid-template-columns: 1fr 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .form-actions {
    flex-direction: column-reverse;
  }

  .form-secondary,
  .form-submit {
    width: 100%;
  }

  .after-success {
    flex-direction: column;
  }
}
/* =========================================================
   BOOKS — COLLECTION CATALOGUE
========================================================= */

.catalog-page {
  min-height: 100vh;

  padding:
    118px
    clamp(18px, 5vw, 76px)
    80px;

  background:
    radial-gradient(
      circle at 85% 15%,
      rgba(210,255,74,.035),
      transparent 27%
    ),
    var(--ink);
}

.catalog-header {
  display: flex;

  justify-content: space-between;

  align-items: flex-end;

  gap: 40px;

  padding-bottom: 35px;

  border-bottom: 1px solid var(--line);
}

.catalog-kicker {
  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .17em;
}

.catalog-header h1 {
  margin: 16px 0 20px;

  font:
    500 clamp(58px, 8vw, 105px)/.82
    var(--serif);

  letter-spacing: -.065em;
}

.catalog-header h1 em {
  color: var(--signal);
}

.catalog-header p {
  max-width: 500px;

  margin: 0;

  color: var(--muted);

  font-size: 14px;

  line-height: 1.7;
}

.catalog-header__actions {
  display: flex;

  align-items: center;

  gap: 20px;
}

.catalog-refresh,
.catalog-add {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  min-height: 44px;

  padding:
    0 14px;

  border: 1px solid var(--line);

  background: none;

  color: var(--paper);

  cursor: pointer;

  font-size: 12px;
}

.catalog-refresh:hover {
  border-color: var(--paper-dim);
}

.catalog-add {
  border-color: var(--signal);

  background: var(--signal);

  color: var(--signal-ink);

  font-weight: 600;
}

.catalog-add:hover {
  background: var(--paper);

  border-color: var(--paper);
}

/* stats */

.catalog-stats {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  margin-top: 30px;

  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.catalog-stats div {
  min-height: 110px;

  padding:
    18px 20px
    18px 0;
}

.catalog-stats div + div {
  border-left: 1px solid var(--line);

  padding-left: 20px;
}

.catalog-stats span {
  display: block;

  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .12em;
}

.catalog-stats strong {
  display: block;

  margin-top: 12px;

  font:
    500 37px
    var(--serif);
}

/* tools */

.catalog-tools {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    210px
    190px;

  gap: 12px;

  margin:
    30px
    0
    38px;
}

.catalog-search,
.catalog-tools select {
  min-height: 48px;

  display: flex;

  align-items: center;

  gap: 10px;

  padding:
    0 13px;

  border-bottom:
    1px solid var(--line);

  background:
    rgba(241,238,231,.018);

  color: var(--muted);
}

.catalog-search input,
.catalog-tools select {
  flex: 1;

  width: 100%;

  border: 0;

  outline: none;

  background: transparent;

  color: var(--paper);

  font-size: 12px;
}

.catalog-search input::placeholder {
  color: #62635e;
}

.catalog-tools select {
  appearance: none;

  cursor: pointer;

  color: var(--paper);
}

.catalog-tools select option {
  background: #151613;
}

/* error/loading */

.catalog-error {
  margin-bottom: 25px;

  padding: 14px;

  border-left: 2px solid var(--danger);

  color: var(--danger);

  font-size: 12px;
}

.catalog-loading {
  min-height: 40vh;

  display: grid;

  place-content: center;

  justify-items: center;

  gap: 12px;

  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .15em;
}

.catalog-loading span {
  width: 150px;

  height: 1px;

  background:
    var(--signal);
}

/* empty */

.catalog-empty {
  min-height: 45vh;

  display: grid;

  place-content: center;

  justify-items: center;

  text-align: center;

  border-top:
    1px solid var(--line);

  border-bottom:
    1px solid var(--line);

  color: var(--muted);
}

.catalog-empty svg {
  color: var(--signal);

  margin-bottom: 20px;
}

.catalog-empty > span {
  font:
    9px
    var(--mono);

  letter-spacing: .16em;
}

.catalog-empty h2 {
  margin: 12px 0 8px;

  font:
    500 42px
    var(--serif);

  color: var(--paper);
}

.catalog-empty p {
  margin: 0 0 22px;

  font-size: 13px;
}

.catalog-empty__link {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  border-bottom:
    1px solid var(--signal);

  padding-bottom: 5px;

  color: var(--signal);

  font-size: 12px;
}

/* cards */

.catalog-grid {
  display: grid;

  grid-template-columns:
    repeat(
      auto-fill,
      minmax(245px, 1fr)
    );

  gap: 18px;
}

.catalog-card {
  position: relative;

  min-height: 390px;

  padding: 15px;

  display: flex;

  flex-direction: column;

  overflow: hidden;

  cursor: pointer;

  border: 1px solid var(--line);

  transition:
    transform .28s var(--ease),
    border-color .28s var(--ease);
}

.catalog-card:hover {
  transform:
    translateY(-6px);

  border-color:
    rgba(210,255,74,.35);
}

.catalog-card--olive {
  background:
    #303a26;
}

.catalog-card--sand {
  background:
    #5a4a35;
}

.catalog-card--rust {
  background:
    #55372e;
}

.catalog-card--blue {
  background:
    #26363a;
}

.catalog-card--plum {
  background:
    #3f303d;
}

.catalog-card--stone {
  background:
    #3e4039;
}

.catalog-card__top {
  display: flex;

  justify-content: space-between;

  color:
    rgba(241,238,231,.58);

  font:
    8px
    var(--mono);

  letter-spacing: .1em;
}

.catalog-cover {
  flex: 1;

  min-height: 270px;

  margin:
    16px 18px;

  padding: 22px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  border:
    1px solid
    rgba(241,238,231,.18);

  background:
    rgba(0,0,0,.14);
}

.catalog-cover__symbol {
  display: grid;

  place-items: center;

  width: 37px;
  height: 37px;

  border:
    1px solid
    rgba(241,238,231,.28);

  color: var(--signal);
}

.catalog-cover small {
  color:
    rgba(241,238,231,.55);

  font:
    8px
    var(--mono);

  letter-spacing: .18em;
}

.catalog-cover h2 {
  max-width: 180px;

  margin: 12px 0 7px;

  font:
    500 clamp(28px, 2.5vw, 38px)/.92
    var(--serif);

  letter-spacing: -.045em;
}

.catalog-cover p {
  margin: 0;

  color:
    rgba(241,238,231,.72);

  font-size: 11px;
}

.catalog-cover__rule {
  width: 42px;

  height: 2px;

  background:
    var(--signal);
}

.catalog-card__bottom {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 10px;

  padding-top: 14px;

  border-top:
    1px solid
    rgba(241,238,231,.14);
}

.catalog-card__bottom span {
  display: block;

  color:
    rgba(241,238,231,.48);

  font:
    8px
    var(--mono);

  letter-spacing: .1em;
}

.catalog-card__bottom strong {
  display: block;

  margin-top: 4px;

  font-size: 11px;
}

.catalog-card__bottom .is-available {
  color: var(--signal);
}

.catalog-card__bottom .is-issued {
  color: #ffb18f;
}

.catalog-card__actions {
  position: absolute;

  top: 13px;
  right: 13px;

  display: flex;

  gap: 5px;

  opacity: 0;

  transform:
    translateY(-4px);

  transition:
    opacity .2s,
    transform .2s;
}

.catalog-card:hover
.catalog-card__actions,
.catalog-card:focus-within
.catalog-card__actions {
  opacity: 1;

  transform:
    translateY(0);
}

.catalog-card__actions button {
  width: 28px;
  height: 28px;

  display: grid;

  place-items: center;

  border: 1px solid
    rgba(241,238,231,.2);

  background:
    rgba(16,17,15,.65);

  color: var(--paper);

  cursor: pointer;

  font:
    8px
    var(--mono);

  letter-spacing: .06em;
}

.catalog-card__actions button:hover {
  color: var(--signal);

  border-color: var(--signal);
}

/* drawer */

.catalog-drawer-backdrop,
.qr-modal-backdrop,
.edit-modal-backdrop {
  position: fixed;

  inset: 0;

  z-index: 200;

  display: flex;

  justify-content: flex-end;

  background:
    rgba(0,0,0,.62);

  backdrop-filter:
    blur(5px);
}

.catalog-drawer {
  width:
    min(520px, 94vw);

  height: 100%;

  overflow-y: auto;

  padding:
    44px 36px;

  background:
    #161713;

  border-left:
    1px solid var(--line);
}

.catalog-drawer__close,
.qr-modal__close,
.edit-modal__head button {
  display: grid;

  place-items: center;

  width: 35px;
  height: 35px;

  margin-left: auto;

  border: 1px solid var(--line);

  background: none;

  color: var(--paper);

  cursor: pointer;
}

.catalog-drawer h2 {
  margin: 20px 0 5px;

  font:
    500 48px/.92
    var(--serif);

  letter-spacing: -.05em;
}

.catalog-drawer__author {
  margin: 0;

  color: var(--muted);

  font-size: 13px;
}

.catalog-drawer__cover {
  min-height: 270px;

  margin:
    30px 0;

  padding: 28px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  background: #343d27;

  color: var(--paper);

  border: 1px solid var(--line);
}

.catalog-drawer__cover strong {
  max-width: 320px;

  font:
    500 42px/.9
    var(--serif);
}

.catalog-drawer__cover span {
  color: var(--signal);

  font:
    9px
    var(--mono);

  letter-spacing: .14em;
}

.catalog-drawer dl {
  margin: 0;
}

.catalog-drawer dl div {
  display: grid;

  grid-template-columns:
    130px
    1fr;

  gap: 15px;

  padding:
    12px 0;

  border-top:
    1px solid var(--line);
}

.catalog-drawer dt {
  color: var(--muted);

  font:
    9px
    var(--mono);

  text-transform: uppercase;
}

.catalog-drawer dd {
  margin: 0;

  color: var(--paper);

  font-size: 12px;
}

.catalog-drawer code {
  color: var(--signal);

  font:
    9px
    var(--mono);

  overflow-wrap: anywhere;
}

.catalog-drawer__actions {
  display: flex;

  gap: 10px;

  margin-top: 30px;
}

.catalog-drawer__actions button,
.qr-copy {
  min-height: 44px;

  padding:
    0 15px;

  border: 1px solid var(--line);

  background: none;

  color: var(--paper);

  cursor: pointer;

  font-size: 12px;
}

.catalog-drawer__actions button:hover,
.qr-copy:hover {
  color: var(--signal);

  border-color: var(--signal);
}

/* QR */

.qr-modal-backdrop {
  align-items: center;

  justify-content: center;
}

.qr-modal {
  position: relative;

  width:
    min(430px, 92vw);

  padding: 36px;

  text-align: center;

  background:
    var(--paper);

  color: var(--ink);
}

.qr-modal__close {
  color: var(--ink);

  border-color:
    rgba(16,17,15,.18);
}

.qr-modal h2 {
  margin: 20px 0;

  font:
    500 38px/.92
    var(--serif);
}

.qr-modal__code {
  width: 245px;
  height: 245px;

  margin:
    20px auto;

  padding: 17px;

  display: grid;

  place-items: center;

  background:
    white;
}

.qr-modal__value {
  display: block;

  color: #55564f;

  font:
    9px
    var(--mono);

  overflow-wrap: anywhere;
}

.qr-copy {
  margin-top: 18px;

  color: var(--ink);

  border-color:
    rgba(16,17,15,.18);
}

/* edit */

.edit-modal-backdrop {
  align-items: center;

  justify-content: center;
}

.edit-modal {
  width:
    min(570px, 94vw);

  padding: 28px;

  background:
    #171814;

  border: 1px solid var(--line);
}

.edit-modal__head {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 20px;

  padding-bottom: 20px;

  border-bottom:
    1px solid var(--line);
}

.edit-modal__head h2 {
  margin: 10px 0 0;

  font:
    500 40px
    var(--serif);
}

.edit-fields {
  display: grid;

  gap: 12px;

  margin-top: 22px;
}

.edit-fields input,
.edit-fields select {
  min-height: 48px;

  padding:
    0 12px;

  border: 0;

  border-bottom:
    1px solid var(--line);

  outline: none;

  background:
    rgba(241,238,231,.025);

  color: var(--paper);
}

.edit-fields select option {
  background: #151613;
}

.edit-modal__save {
  width: 100%;

  min-height: 48px;

  margin-top: 22px;

  border: 1px solid var(--signal);

  background: var(--signal);

  color: var(--signal-ink);

  cursor: pointer;

  font-weight: 600;
}

@media (max-width: 800px) {
  .catalog-header {
    flex-direction: column;

    align-items: flex-start;
  }

  .catalog-header__actions {
    width: 100%;
  }

  .catalog-refresh,
  .catalog-add {
    flex: 1;

    justify-content: center;
  }

  .catalog-stats {
    grid-template-columns:
      repeat(2, 1fr);
  }

  .catalog-stats div:nth-child(3) {
    border-left: 0;

    padding-left: 0;

    border-top:
      1px solid var(--line);
  }

  .catalog-stats div:nth-child(4) {
    border-top:
      1px solid var(--line);
  }

  .catalog-tools {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 550px) {
  .catalog-page {
    padding:
      98px
      16px
      50px;
  }

  .catalog-header h1 {
    font-size: 60px;
  }

  .catalog-stats strong {
    font-size: 30px;
  }

  .catalog-drawer {
    padding:
      30px 20px;
  }

  .catalog-drawer h2 {
    font-size: 40px;
  }

  .catalog-drawer__actions {
    flex-direction: column;
  }

  .catalog-drawer__actions button {
    width: 100%;
  }
}
/* =========================================================
   FINAL LAYOUT SAFETY FIXES
========================================================= */

/* Never allow a page section to create horizontal overflow */
.landing-page,
.workspace-page,
.tool-page,
.catalog-page,
.add-book-page {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}

/* Grid children must be allowed to shrink */
.hero-instrument > *,
.editorial-section > *,
.story-band > *,
.landing-data-section > *,
.landing-command > *,
.workspace-grid > *,
.workspace-header > *,
.transaction-strip,
.transaction-strip__head > *,
.context-rail > *,
.scanner-workspace > *,
.scanner-rail > *,
.add-book-layout > *,
.catalog-header > * {
  min-width: 0;
}

/* -------------------------
   RECENT MOVEMENT
-------------------------- */

.transaction-strip {
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.transaction-strip__head {
  display: grid !important;

  grid-template-columns:
    minmax(220px, 1fr)
    minmax(280px, auto);

  align-items: end;

  column-gap: 35px;

  width: 100%;
}

.transaction-strip__head > div:first-child {
  min-width: 0;
}

.transaction-strip__head h2 {
  margin: 9px 0 0 !important;

  font-family: var(--serif) !important;
  font-size: clamp(32px, 3vw, 52px) !important;
  font-weight: 500 !important;
  line-height: .95 !important;

  letter-spacing: -.045em !important;

  white-space: normal !important;
  overflow-wrap: anywhere;
}

.transaction-filters {
  min-width: 0;
  width: 100%;
  justify-content: flex-end;
}

.transaction-row {
  width: 100%;
  min-width: 0;

  grid-template-columns:
    minmax(0, 1.5fr)
    minmax(140px, 1fr)
    minmax(100px, .7fr)
    minmax(75px, .5fr);
}

.transaction-row > * {
  min-width: 0;
  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;
}

/* -------------------------
   LANDING HEADINGS
-------------------------- */

.editorial-section__headline,
.evidence-title,
.story-band__copy,
.landing-command__heading,
.landing-data-section__header > * {
  min-width: 0;
}

.editorial-section__headline h2,
.evidence-title h2,
.story-band__copy h2,
.landing-command__heading h2,
.landing-data-section__header h2 {
  max-width: 100%;

  overflow-wrap: anywhere;

  word-break: normal;
}

/* -------------------------
   HERO
-------------------------- */

.hero-instrument {
  width: 100%;
  max-width: 100vw;
}

.hero-instrument__copy,
.hero-instrument__visual,
.hero-instrument__readout {
  min-width: 0;
}

.hero-instrument__copy h1 {
  max-width: 100%;
  overflow-wrap: anywhere;
}

/* -------------------------
   NETWORK
-------------------------- */

.network-field {
  width: 100%;
  max-width: 100%;
  min-width: 0;

  overflow: hidden;
}

.network-field__svg {
  max-width: none;
}

/* -------------------------
   MOBILE / SMALL LAPTOP
-------------------------- */

@media (max-width: 1050px) {
  .transaction-strip__head {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .transaction-filters {
    justify-content: flex-start;
  }

  .landing-data-section__header {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 760px) {
  .transaction-row {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(100px, .8fr);
  }

  .transaction-row > span:nth-child(3),
  .transaction-row > span:nth-child(4) {
    display: none;
  }

  .transaction-row--head > span:nth-child(3),
  .transaction-row--head > span:nth-child(4) {
    display: none;
  }

  .transaction-filters {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }
}
@media (max-width: 1100px) {
  .editorial-section {
    grid-template-columns:
      95px
      minmax(0, 1fr)
      minmax(0, 1fr);
  }

  .editorial-section__headline {
    min-width: 0;
  }

  .editorial-section__headline h2 {
    font-size: clamp(
      42px,
      6vw,
      72px
    );
  }
}

@media (max-width: 780px) {
  .editorial-section {
    grid-template-columns: 1fr;
  }

  .editorial-section__headline h2 {
    font-size: clamp(
      44px,
      13vw,
      68px
    );
  }
}
/* =========================================================
   DASHBOARD FINAL STRUCTURE FIX
========================================================= */

.workspace-page {
  position: relative;
  width: 100%;
  min-height: 100vh;

  padding:
    112px
    clamp(18px, 4vw, 56px)
    70px;

  overflow-x: clip;
}

.workspace-header {
  width: 100%;

  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 40px;

  padding-bottom: 28px;

  border-bottom: 1px solid var(--line);
}

.workspace-title {
  min-width: 0;
}

.workspace-title h1 {
  margin:
    12px 0 0;

  max-width: 100%;

  font:
    500
    clamp(50px, 7vw, 94px)/.88
    var(--serif);

  letter-spacing: -.055em;
}

.workspace-title h1 em {
  color: var(--signal);
}

.workspace-actions {
  display: flex;

  flex-shrink: 0;

  align-items: center;

  gap: 22px;
}

.utility-link {
  display: inline-flex;

  align-items: center;

  gap: 8px;

  border: 0;

  padding: 8px 0;

  background: none;

  color: var(--muted);

  cursor: pointer;

  font-size: 12px;
}

.utility-link:hover {
  color: var(--paper);
}

.utility-link--solid {
  color: var(--signal);

  border-bottom:
    1px solid var(--signal);
}

.utility-link:disabled {
  opacity: .5;

  cursor: wait;
}

.is-spinning {
  animation:
    dashboard-spin .9s
    linear infinite;
}

@keyframes dashboard-spin {
  to {
    transform: rotate(360deg);
  }
}

.workspace-error {
  margin:
    18px
    0;

  padding:
    13px
    15px;

  color: var(--danger);

  border-left:
    2px solid var(--danger);

  background:
    rgba(255,177,143,.025);

  font-size: 12px;
}

/* overview */

.dashboard-overview {
  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  width: 100%;

  margin-top: 28px;

  border-top:
    1px solid var(--line);

  border-bottom:
    1px solid var(--line);
}

.overview-item {
  min-width: 0;

  min-height: 120px;

  padding:
    18px
    24px
    18px
    0;
}

.overview-item + .overview-item {
  border-left:
    1px solid var(--line);

  padding-left: 24px;
}

.overview-item strong {
  display: block;

  margin-top: 8px;

  font:
    500 38px
    var(--serif);
}

.overview-item small {
  display: block;

  margin-top: 5px;

  color: var(--muted);

  font-size: 11px;
}

/* MAIN */

.dashboard-main {
  display: grid;

  grid-template-columns:
    minmax(0, 1.65fr)
    minmax(270px, .55fr);

  gap: 24px;

  width: 100%;

  margin-top: 28px;
}

/* NETWORK */

.dashboard-network {
  min-width: 0;
}

.dashboard-network__header {
  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 20px;

  padding-bottom: 14px;

  border-bottom:
    1px solid var(--line);
}

.dashboard-network__header h2 {
  margin:
    9px 0 0;

  font:
    500 34px
    var(--serif);

  letter-spacing: -.04em;
}

.dashboard-availability {
  display: flex;

  flex-direction: column;

  align-items: flex-end;

  flex-shrink: 0;
}

.dashboard-availability strong {
  color: var(--signal);

  font:
    500 29px
    var(--serif);
}

.dashboard-network__field {
  width: 100%;

  height: 570px;

  margin-top: 16px;

  min-width: 0;
}

.dashboard-network__field .network-field {
  width: 100%;
  height: 100%;
  min-height: 0;
}

.dashboard-network__footer {
  display: flex;

  justify-content: space-between;

  gap: 20px;

  padding:
    10px 0;

  border-bottom:
    1px solid var(--line);

  color: var(--muted);

  font:
    9px
    var(--mono);

  text-transform: uppercase;

  letter-spacing: .12em;
}

/* SIDE */

.dashboard-side {
  min-width: 0;

  border-left:
    1px solid var(--line);
}

.dashboard-side__block {
  min-width: 0;

  padding:
    21px 0
    25px 24px;

  border-bottom:
    1px solid var(--line);
}

.dashboard-side__selected {
  min-height: 320px;
}

.dashboard-side__block h2 {
  margin:
    14px 0 5px;

  font:
    500 36px/.95
    var(--serif);

  letter-spacing: -.045em;

  overflow-wrap: anywhere;
}

.dashboard-side__block p {
  margin: 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.5;
}

.selected-details {
  margin-top: 24px;
}

.selected-details > div {
  display: flex;

  justify-content: space-between;

  gap: 20px;

  padding:
    10px 0;

  border-top:
    1px solid var(--line);
}

.selected-details span {
  color: var(--muted);

  font-size: 10px;
}

.selected-details strong {
  max-width: 56%;

  text-align: right;

  font-size: 11px;

  overflow-wrap: anywhere;
}

.selected-empty {
  display: flex;

  align-items: flex-start;

  gap: 13px;

  margin-top: 28px;
}

.selected-empty > div {
  width: 24px;
  height: 24px;

  display: grid;

  place-items: center;

  flex-shrink: 0;

  border: 1px solid var(--line);

  color: var(--signal);
}

.selected-empty p {
  max-width: 230px;
}

/* circulation */

.circulation-summary {
  display: grid;

  grid-template-columns:
    1fr 1fr;

  margin-top: 18px;
}

.circulation-summary > div {
  display: flex;

  flex-direction: column;

  gap: 3px;
}

.circulation-summary > div + div {
  border-left:
    1px solid var(--line);

  padding-left: 16px;
}

.circulation-summary strong {
  font:
    500 29px
    var(--serif);
}

.circulation-summary span {
  color: var(--muted);

  font:
    9px
    var(--mono);

  text-transform: uppercase;

  letter-spacing: .08em;
}

/* chart */

.activity-chart {
  display: grid;

  grid-template-columns:
    repeat(7, 1fr);

  align-items: end;

  gap: 7px;

  height: 155px;

  margin-top: 20px;

  padding-top: 15px;

  border-top:
    1px solid var(--line);
}

.activity-column {
  height: 100%;

  display: grid;

  grid-template-rows:
    1fr
    auto
    auto;

  gap: 5px;

  justify-items: center;
}

.activity-column__bar {
  align-self: end;

  width: 100%;

  max-width: 16px;

  min-height: 2px;

  background:
    var(--signal);

  opacity: .82;
}

.activity-column small {
  color: var(--muted);

  font-size: 8px;
}

.activity-column span {
  color: var(--paper-dim);

  font:
    8px
    var(--mono);
}

/* TRANSACTIONS */

.transaction-strip {
  width: 100%;

  margin-top: 38px;

  padding-top: 28px;

  border-top:
    1px solid var(--line);
}

.transaction-strip__head {
  width: 100%;

  display: flex;

  justify-content: space-between;
  align-items: flex-end;

  gap: 35px;

  margin-bottom: 17px;
}

.transaction-strip__head > div:first-child {
  min-width: 0;
}

.transaction-strip__head h2 {
  margin:
    10px 0 0;

  font:
    500 clamp(36px, 4vw, 55px)/.9
    var(--serif);

  letter-spacing: -.045em;

  white-space: normal;
}

.transaction-filters {
  display: flex;

  flex-shrink: 0;

  align-items: center;

  gap: 15px;
}

.search-line {
  width: min(310px, 30vw);

  display: flex;

  align-items: center;

  gap: 8px;

  padding-bottom: 8px;

  border-bottom:
    1px solid var(--line);

  color: var(--muted);
}

.search-line input {
  min-width: 0;

  width: 100%;

  border: 0;

  outline: 0;

  background: transparent;

  color: var(--paper);

  font-size: 11px;
}

.search-line input::placeholder {
  color: #62645e;
}

.transaction-filters select {
  min-height: 32px;

  padding:
    0;

  border: 0;

  border-bottom:
    1px solid var(--line);

  outline: 0;

  background:
    var(--ink);

  color: var(--paper);

  cursor: pointer;

  font-size: 11px;
}

.transaction-filters select option {
  background:
    var(--ink);
}

.transaction-table {
  width: 100%;

  border-top:
    1px solid var(--line);
}

.transaction-row {
  display: grid;

  grid-template-columns:
    minmax(0, 1.6fr)
    minmax(120px, 1fr)
    minmax(100px, .65fr)
    minmax(80px, .45fr);

  gap: 18px;

  width: 100%;

  min-width: 0;

  padding:
    14px 0;

  border-bottom:
    1px solid var(--line);

  font-size: 11px;
}

.transaction-row span {
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;

  white-space: nowrap;
}

.transaction-row--head {
  color: var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .12em;

  text-transform: uppercase;
}

.transaction-empty {
  padding:
    24px 0;

  color: var(--muted);

  font-size: 12px;
}

/* TABLET */

@media (max-width: 1050px) {
  .dashboard-main {
    grid-template-columns: 1fr;
  }

  .dashboard-side {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);

    border-left: 0;

    border-top:
      1px solid var(--line);
  }

  .dashboard-side__block {
    padding-left: 0;
    padding-right: 24px;
  }

  .dashboard-side__block + .dashboard-side__block {
    border-left:
      1px solid var(--line);

    padding-left: 24px;
  }

  .transaction-strip__head {
    align-items: flex-start;
  }
}

/* SMALL */

@media (max-width: 760px) {
  .workspace-page {
    padding:
      98px
      17px
      50px;
  }

  .workspace-header {
    display: block;
  }

  .workspace-actions {
    margin-top: 22px;
  }

  .dashboard-overview {
    grid-template-columns:
      1fr 1fr;
  }

  .overview-item {
    padding-right: 15px;
  }

  .overview-item + .overview-item {
    padding-left: 15px;
  }

  .overview-item:nth-child(3) {
    border-left: 0;
    border-top:
      1px solid var(--line);

    padding-left: 0;
  }

  .overview-item:nth-child(4) {
    border-top:
      1px solid var(--line);
  }

  .dashboard-network__header {
    align-items: flex-start;
  }

  .dashboard-network__header h2 {
    font-size: 28px;
  }

  .dashboard-network__field {
    height: 450px;
  }

  .dashboard-network__footer {
    flex-direction: column;
    gap: 7px;
  }

  .dashboard-side {
    display: block;
  }

  .dashboard-side__block,
  .dashboard-side__block + .dashboard-side__block {
    padding:
      20px 0
      24px;

    border-left: 0;
  }

  .transaction-strip {
    margin-top: 28px;
  }

  .transaction-strip__head {
    display: block;
  }

  .transaction-filters {
    display: grid;

    grid-template-columns:
      1fr;

    margin-top: 20px;
  }

  .search-line {
    width: 100%;
  }

  .transaction-row {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(100px, .8fr);
  }

  .transaction-row > span:nth-child(3),
  .transaction-row > span:nth-child(4) {
    display: none;
  }

  .transaction-row--head
    > span:nth-child(3),
  .transaction-row--head
    > span:nth-child(4) {
    display: none;
  }
}
/* =========================================================
   CINEMATIC HOME
========================================================= */

.cinematic-home {
  width: 100%;

  background:
    var(--ink);

  color:
    var(--paper);

  overflow-x: clip;
}

.cinematic-hero {
  position: relative;

  min-height: 100vh;

  width: 100%;

  overflow: hidden;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  isolation: isolate;
}

.cinematic-hero__video {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: -3;

  filter:
    brightness(.58)
    contrast(1.08)
    saturate(.9);

  transform:
    scale(1.015);
}

.cinematic-hero__dark {
  position: absolute;

  inset: 0;

  z-index: -2;

  background:
    linear-gradient(
      90deg,
      rgba(8,9,7,.87) 0%,
      rgba(8,9,7,.56) 38%,
      rgba(8,9,7,.12) 72%,
      rgba(8,9,7,.42) 100%
    ),
    linear-gradient(
      180deg,
      rgba(8,9,7,.65) 0%,
      transparent 35%,
      rgba(8,9,7,.78) 100%
    );
}

.cinematic-hero__grain {
  position: absolute;

  inset: 0;

  z-index: -1;

  opacity: .12;

  pointer-events: none;

  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");

  mix-blend-mode: soft-light;
}

.cinematic-hero__top {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 20px;

  padding:
    100px
    clamp(20px, 5vw, 70px)
    0;
}

.cinematic-status {
  display: flex;

  align-items: center;

  gap: 10px;

  color: rgba(241,238,231,.78);

  font:
    10px
    var(--mono);

  text-transform: uppercase;

  letter-spacing: .13em;
}

.status-light {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--signal);

  box-shadow:
    0 0 0 5px
    rgba(210,255,74,.07);
}

.cinematic-hero__content {
  width: min(
    850px,
    100%
  );

  padding:
    0
    clamp(20px, 5vw, 70px)
    70px;
}

.cinematic-hero__kicker {
  display: inline-flex;

  padding-bottom: 9px;

  margin-bottom: 19px;

  border-bottom:
    1px solid
    rgba(241,238,231,.23);

  color:
    var(--signal);

  font:
    9px
    var(--mono);

  letter-spacing: .17em;
}

.cinematic-hero__content h1 {
  margin: 0;

  max-width: 900px;

  font:
    500 clamp(
      64px,
      10vw,
      145px
    )/.81
    var(--serif);

  letter-spacing: -.065em;
}

.cinematic-hero__content h1 em {
  color: var(--signal);

  font-style: italic;
}

.cinematic-hero__content p {
  max-width: 560px;

  margin:
    27px
    0
    0;

  color:
    rgba(241,238,231,.78);

  font-size:
    clamp(
      14px,
      1.5vw,
      18px
    );

  line-height: 1.7;
}

.cinematic-hero__actions {
  display: flex;

  flex-wrap: wrap;

  gap: 18px;

  margin-top: 30px;
}

.cinematic-primary,
.cinematic-secondary {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  min-height: 48px;

  padding:
    0
    18px;

  font-size: 12px;
}

.cinematic-primary {
  background:
    var(--signal);

  color:
    var(--signal-ink);

  font-weight: 600;
}

.cinematic-primary:hover {
  background:
    var(--paper);
}

.cinematic-secondary {
  color:
    var(--paper);

  border:
    1px solid
    rgba(241,238,231,.27);
}

.cinematic-secondary:hover {
  border-color:
    var(--paper);
}

.cinematic-video-control {
  position: absolute;

  right:
    clamp(20px, 5vw, 70px);

  bottom: 120px;

  z-index: 5;

  display: inline-flex;

  align-items: center;

  gap: 8px;

  padding:
    8px 10px;

  border:
    1px solid
    rgba(241,238,231,.2);

  background:
    rgba(8,9,7,.34);

  color:
    var(--paper);

  cursor: pointer;

  font:
    9px
    var(--mono);

  text-transform:
    uppercase;

  letter-spacing: .11em;
}

.cinematic-video-control:hover {
  color:
    var(--signal);

  border-color:
    rgba(210,255,74,.42);
}

.cinematic-hero__bottom {
  display: flex;

  justify-content:
    space-between;

  align-items:
    flex-end;

  gap: 30px;

  padding:
    0
    clamp(20px, 5vw, 70px)
    22px;
}

.cinematic-hero__bottom > div:first-child {
  display: grid;

  gap: 9px;
}

.cinematic-scroll {
  display: inline-flex;

  align-items: center;

  gap: 6px;

  color:
    rgba(241,238,231,.58);

  font-size: 11px;
}

.cinematic-meta {
  display: flex;

  gap: 18px;

  color:
    rgba(241,238,231,.44);

  font:
    9px
    var(--mono);

  letter-spacing: .1em;
}

/* editorial */

.home-editorial {
  display: grid;

  grid-template-columns:
    110px
    minmax(0, .95fr)
    minmax(0, .75fr);

  gap: 40px;

  padding:
    clamp(100px, 12vw, 170px)
    clamp(20px, 7vw, 110px);

  border-top:
    1px solid var(--line);
}

.home-editorial__title h2,
.home-split__copy h2,
.home-control__heading h2,
.home-final h2 {
  margin:
    10px 0 0;

  font:
    500 clamp(
      45px,
      6vw,
      88px
    )/.9
    var(--serif);

  letter-spacing: -.055em;
}

.home-editorial__title h2 em,
.home-split__copy h2 em,
.home-control__heading h2 em,
.home-final h2 em {
  color: var(--signal);

  font-style: italic;
}

.home-editorial__copy {
  align-self: end;

  max-width: 430px;
}

.home-editorial__copy p,
.home-control__heading p,
.home-split__copy p {
  color: var(--muted);

  font-size: 14px;

  line-height: 1.75;
}

.home-editorial__copy p {
  margin-bottom: 27px;
}

/* split */

.home-split {
  display: grid;

  grid-template-columns:
    1.1fr .9fr;

  border-top:
    1px solid var(--line);
}

.home-split__visual {
  min-height: 680px;

  display: grid;

  place-items: center;

  border-right:
    1px solid var(--line);

  background:
    radial-gradient(
      circle,
      rgba(210,255,74,.07),
      transparent 34%
    );
}

.qr-art {
  position: relative;

  width: min(
    70%,
    510px
  );

  aspect-ratio: 1;
}

.qr-art__square {
  position: absolute;

  inset: 14%;

  display: grid;

  grid-template-columns:
    1fr 1fr;

  gap: 5px;

  padding: 8%;

  border:
    1px solid
    rgba(210,255,74,.2);
}

.qr-art__square span {
  border:
    1px solid
    rgba(241,238,231,.18);

  background:
    repeating-linear-gradient(
      45deg,
      rgba(210,255,74,.1)
      0 4px,
      transparent 4px 9px
    );
}

.qr-art__beam {
  position: absolute;

  left: 3%;
  right: 3%;

  top: 50%;

  height: 1px;

  background: var(--signal);

  box-shadow:
    0 0 35px
    rgba(210,255,74,.55);

  animation:
    home-scan
    3.4s
    ease-in-out
    infinite;
}

@keyframes home-scan {
  0%,
  100% {
    transform:
      translateY(-130px);

    opacity: .35;
  }

  50% {
    transform:
      translateY(130px);

    opacity: 1;
  }
}

.qr-art__label {
  position: absolute;

  right: 0;

  bottom: 4%;

  display: flex;

  align-items: center;

  gap: 8px;

  color: var(--signal);

  font:
    9px
    var(--mono);

  letter-spacing: .13em;
}

.home-split__copy {
  align-self: center;

  padding:
    90px
    clamp(25px, 7vw, 110px);
}

/* control */

.home-control {
  display: grid;

  grid-template-columns:
    .7fr
    1.3fr;

  gap: 70px;

  padding:
    clamp(100px, 12vw, 170px)
    clamp(20px, 7vw, 110px);

  border-top:
    1px solid var(--line);
}

.home-control__heading {
  align-self: center;

  max-width: 450px;
}

.home-control__heading p {
  margin-top: 25px;
}

.home-control__panel {
  min-height: 470px;

  border:
    1px solid var(--line);

  background:
    #12130f;
}

.fake-control-top,
.fake-control-bottom {
  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 15px;

  padding:
    14px 17px;

  color:
    var(--muted);

  font:
    9px
    var(--mono);

  letter-spacing: .12em;
}

.fake-control-top {
  border-bottom:
    1px solid var(--line);
}

.fake-control-bottom {
  border-top:
    1px solid var(--line);
}

.fake-control-bottom strong {
  color: var(--signal);

  font:
    500 21px
    var(--serif);
}

.fake-network {
  position: relative;

  height: 370px;

  overflow: hidden;

  background-image:
    linear-gradient(
      rgba(241,238,231,.04) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(241,238,231,.04) 1px,
      transparent 1px
    );

  background-size:
    12.5%
    20%;
}

.fake-network::before,
.fake-network::after {
  content: "";

  position: absolute;

  background:
    var(--line);
}

.fake-network::before {
  top: 50%;
  left: 8%;
  right: 8%;

  height: 1px;
}

.fake-network::after {
  top: 12%;
  bottom: 12%;
  left: 50%;

  width: 1px;
}

.fake-network span {
  position: absolute;

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background:
    #5d6258;
}

.fake-network span:nth-child(3n) {
  background:
    var(--signal);

  box-shadow:
    0 0 0 6px
    rgba(210,255,74,.06);
}

/* final */

.home-final {
  display: grid;

  grid-template-columns:
    1fr
    1fr;

  min-height: 620px;

  padding:
    clamp(90px, 11vw, 150px)
    clamp(20px, 7vw, 110px);

  border-top:
    1px solid var(--line);
}

.home-final__actions {
  align-self: end;
}

.final-action {
  min-height: 80px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  border-top:
    1px solid var(--line);

  color: var(--paper);

  font:
    500 26px
    var(--serif);

  transition:
    padding-left .25s
    var(--ease),
    color .25s;
}

.final-action:last-child {
  border-bottom:
    1px solid var(--line);
}

.final-action:hover {
  padding-left: 12px;

  color: var(--signal);
}

@media (max-width: 800px) {
  .cinematic-hero__top {
    padding-top: 88px;
  }

  .cinematic-hero__content {
    padding-bottom: 55px;
  }

  .cinematic-hero__content h1 {
    font-size: clamp(
      59px,
      17vw,
      90px
    );
  }

  .cinematic-hero__bottom {
    display: block;
  }

  .cinematic-meta {
    margin-top: 15px;
  }

  .home-editorial,
  .home-control,
  .home-final {
    grid-template-columns: 1fr;
  }

  .home-editorial {
    gap: 30px;
  }

  .home-split {
    grid-template-columns: 1fr;
  }

  .home-split__visual {
    min-height: 500px;

    border-right: 0;

    border-bottom:
      1px solid var(--line);
  }

  .home-control {
    gap: 50px;
  }

  .home-final {
    min-height: auto;
    gap: 60px;
  }
}
/* =========================================================
