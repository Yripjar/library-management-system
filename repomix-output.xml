.interactive-book {
  position: relative;

  overflow: hidden;

  padding: 22px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  border:
    1px solid
    rgba(241,238,231,.14);

  cursor: pointer;

  transition:
    transform .18s ease,
    border-color .25s ease;

  transform-style:
    preserve-3d;

  will-change:
    transform;
}

.interactive-book:hover {
  border-color:
    rgba(210,255,74,.4);
}

.interactive-book--large {
  grid-row:
    1 / span 2;

  background:
    linear-gradient(
      145deg,
      #3a482b,
      #20271b
    );
}

.interactive-book--small {
  background:
    linear-gradient(
      145deg,
      #453b30,
      #27231d
