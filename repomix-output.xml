  return (
    <div className="relative max-w-7xl mx-auto px-6 py-14">

      {/* Ambient light */}
      <div className="pointer-events-none absolute -top-32 -left-40 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-3xl" />

      {/* Header */}
      <div className="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">

        <div>
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-sm mb-4">
            <BookOpen className="w-4 h-4" />
            Collection
          </div>

          <h1 className="text-5xl md:text-6xl font-black tracking-tight">
            Library
            <span className="block bg-gradient-to-r from-purple-400 to-cyan-400 bg-clip-text text-transparent">
              Books
            </span>
          </h1>

          <p className="mt-4 text-lg text-slate-500">
            Explore, update and manage every title in your library.
          </p>
        </div>

        <div className="flex flex-wrap gap-3">

          <button
            onClick={fetchBooks}
            className="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/[0.04] border border-white/10 text-slate-300 hover:bg-white/[0.08] transition-all"
          >
            <RefreshCw className="w-4 h-4" />
            Refresh
          </button>

          <Link
            to="/add"
            className="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-purple-500 to-cyan-500 font-semibold hover:scale-[1.03] transition-transform"
          >
            <Plus className="w-4 h-4" />
            Add Book
          </Link>

        </div>
      </div>

      {/* Filters */}
      <div className="relative mb-10 rounded-3xl border border-white/[0.08] bg-white/[0.035] backdrop-blur-xl p-5">

        <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">

          <div className="relative">
            <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-600" />

            <input
              value={filters.title}
              onChange={(e) =>
                updateFilter('title', e.target.value)
              }
              placeholder="Search by title..."
              className="w-full rounded-xl bg-white/[0.04] border border-white/10 pl-11 pr-4 py-3 text-white placeholder-slate-600 outline-none focus:border-purple-500/50 transition-colors"
            />
          </div>

          <div className="relative">
            <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-600" />

            <input
              value={filters.author}
              onChange={(e) =>
                updateFilter('author', e.target.value)
              }
              placeholder="Search by author..."
              className="w-full rounded-xl bg-white/[0.04] border border-white/10 pl-11 pr-4 py-3 text-white placeholder-slate-600 outline-none focus:border-purple-500/50 transition-colors"
            />
          </div>

          <input
            value={filters.category}
