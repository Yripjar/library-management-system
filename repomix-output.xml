@media (max-width: 800px) {
  .scroll-video-hero {
    height: 240vh;
  }

  .scroll-video-hero__top {
    padding-top: 88px;
  }

  .scroll-video-hero__content {
    left: 20px;
    right: 20px;
    bottom: 145px;

    width: auto;
  }

  .scroll-video-hero__content h1 {
    font-size:
