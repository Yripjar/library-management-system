import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import {
  ArrowDown,
  ArrowRight,
  BookOpen,
  BarChart3,
  QrCode,
  ScanLine,
  Sparkles,
  CheckCircle,
} from 'lucide-react';
