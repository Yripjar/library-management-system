.interactive-book--small:nth-child(3) {
  background:
    linear-gradient(
      145deg,
      #333f41,
      #202829
    );
}

.interactive-book--wide {
  grid-column:
    2 / span 2;

  background:
    linear-gradient(
      145deg,
      #44363e,
      #282129
    );
}

.interactive-book::before {
  content: "";

  position: absolute;

  inset: 14px;

  border:
    1px solid
