========================================================= */

.scroll-video-hero {
  position: relative;

  width: 100%;

  /*
   * This controls how much scrolling is available
   * for the video.
   *
   * 280vh means:
   * 1 screen = video visible
   * + extra 180vh = video scrubbing time
   */
  height: 280vh;

  background:
    #080907;
}

.scroll-video-hero__sticky {
  position: sticky;

  top: 0;

  height: 100vh;

  width: 100%;

  overflow: hidden;

  isolation: isolate;
}

.scroll-video-hero__video {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  z-index: -3;

  pointer-events: none;

  filter:
    brightness(.62)
    contrast(1.08)
    saturate(.92);

  will-change:
    transform;
}

.scroll-video-hero__overlay {
  position: absolute;

  inset: 0;

  z-index: -2;

  background:
    linear-gradient(
      90deg,
      rgba(7,8,6,.88) 0%,
      rgba(7,8,6,.52) 38%,
      rgba(7,8,6,.12) 72%,
      rgba(7,8,6,.48) 100%
    ),
