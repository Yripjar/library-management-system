            <span />
            <span />
          </span>

          <span className="brand__word">NexLib</span>
        </Link>

        <nav className="site-nav__links" aria-label="Primary">
          {links.map((link) => {
            const active = location.pathname === link.to;

            return (
              <Link
                key={link.to}
