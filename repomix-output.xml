/* =========================================================
   MOBILE / IOS / ANDROID OPTIMIZATION
========================================================= */

html {
  overflow-x: hidden;
  -webkit-text-size-adjust: 100%;
}

body {
  overflow-x: hidden;
  overscroll-behavior-x: none;
}

button,
a,
input,
select {
  touch-action: manipulation;
}

img,
video,
canvas {
  max-width: 100%;
}

/* -------------------------
   HERO VIDEO
-------------------------- */

.scroll-video-hero__sticky {
  width: 100%;
  max-width: 100vw;
}

.scroll-video-hero__video {
  width: 100%;
  height: 100%;

  object-fit: cover;

  /*
   * Helps Safari/iOS avoid treating
   * the video as a normal playback target.
   */
  -webkit-transform: translateZ(0);
  transform: translateZ(0);

  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
}

/* -------------------------
   TOUCH DEVICES
-------------------------- */

@media (hover: none) and (pointer: coarse) {
  .interactive-book {
    /*
     * Disable the desktop pointer tilt on
     * touch devices. Touch already has its
     * own interaction model.
     */
    transform: none !important;
  }

  .interactive-book:hover {
    transform: none !important;
  }

  .interactive-book__glow {
    display: none;
  }

  .catalog-card:hover {
    transform: none;
  }

  .showcase-book:hover {
    transform: none;
  }

  .final-action:hover {
    padding-left: 0;
  }

  /*
   * Make controls comfortable for fingers.
   */
  .cinematic-primary,
  .cinematic-secondary,
  .scroll-video-control,
  .final-action,
  .catalog-add,
  .catalog-refresh,
  .form-submit,
  .control-link {
    min-height: 48px;
  }
}

