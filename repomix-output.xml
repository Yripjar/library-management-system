import { useState } from 'react';
import api from '../api';
import gsap from 'gsap';
import { CheckCircle, Loader2, Plus } from 'lucide-react';

const categories = [
  'Fiction',
  'Non-Fiction',
  'Science',
  'Technology',
  'History',
  'Biography',
];

export default function AddBook() {
  const [form, setForm] = useState({
    title: '',
    author: '',
    isbn: '',
    category: '',
    quantity: 1,
  });

  const [errors, setErrors] = useState({});
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [isSuccess, setIsSuccess] = useState(false);

  const handleChange = (event) => {
    const { name, value } = event.target;

    setForm((previous) => ({
      ...previous,
      [name]: name === 'quantity' ? Number(value) : value,
    }));

    if (errors[name]) {
      setErrors((previous) => ({
        ...previous,
        [name]: '',
      }));
    }
  };

  const validate = () => {
    const newErrors = {};

    if (!form.title.trim()) {
      newErrors.title = 'Title is required';
    }

    if (!form.author.trim()) {
      newErrors.author = 'Author is required';
    }

    if (!form.isbn.trim()) {
      newErrors.isbn = 'ISBN / Book ID is required';
    }

    if (!form.category) {
      newErrors.category = 'Choose a category';
    }

    if (!form.quantity || form.quantity < 1) {
      newErrors.quantity = 'At least 1 copy is required';
    }

    return newErrors;
  };

  const handleSubmit = async (event) => {
    event.preventDefault();

    const validationErrors = validate();

    if (Object.keys(validationErrors).length > 0) {
      setErrors(validationErrors);

      gsap.fromTo(
        '.error-message',
        { y: -6, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.35,
          stagger: 0.05,
        }
      );

      return;
    }

    try {
      setIsSubmitting(true);
      setErrors({});

      await api.post('/books', {
        title: form.title.trim(),
        author: form.author.trim(),
        isbn: form.isbn.trim(),
        category: form.category,
        totalCopies: Number(form.quantity),
      });

      setIsSuccess(true);

      gsap.fromTo(
        '.success-toast',
        { y: 30, opacity: 0, scale: 0.95 },
        {
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.5,
          ease: 'back.out',
        }
      );

      setForm({
        title: '',
        author: '',
        isbn: '',
        category: '',
        quantity: 1,
      });

      setTimeout(() => {
        setIsSuccess(false);
      }, 2200);
    } catch (err) {
      setErrors({
        general:
          err.response?.data?.message ||
          err.response?.data?.errors?.[0]?.msg ||
          'Unable to add book',
      });
    } finally {
      setIsSubmitting(false);
    }
  };

  const inputClass = (field) => `
    peer w-full rounded-xl
    bg-white/[0.045]
    border ${errors[field] ? 'border-red-500/60' : 'border-white/10'}
    px-4 py-4 text-white
    placeholder-transparent
    outline-none
    transition-all duration-200
    focus:border-purple-500/70
    focus:ring-4 focus:ring-purple-500/10
  `;

  return (
    <div className="max-w-2xl mx-auto px-6 py-16">

      <div className="mb-10">
        <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-sm mb-4">
          <Plus className="w-4 h-4" />
          Library Collection
        </div>

        <h1 className="text-4xl md:text-5xl font-black text-white">
          Add New Book
        </h1>

        <p className="text-slate-500 mt-3">
          Add a title to your library and automatically generate its QR identity.
        </p>
      </div>

      <form
        onSubmit={handleSubmit}
        className="rounded-3xl border border-white/[0.08] bg-white/[0.035] backdrop-blur-xl p-6 md:p-8 shadow-2xl"
      >

        <div className="space-y-6">

          {/* Title */}
          <div className="relative">
            <input
              id="title"
              name="title"
              type="text"
              value={form.title}
              onChange={handleChange}
              className={inputClass('title')}
              placeholder="Title"
            />

            <label
              htmlFor="title"
              className="absolute left-3 -top-2.5 bg-slate-950 px-2 text-sm text-slate-400"
            >
              Title
            </label>

            {errors.title && (
              <p className="error-message mt-2 text-sm text-red-400">
                {errors.title}
              </p>
            )}
          </div>

          {/* Author */}
          <div className="relative">
            <input
              id="author"
              name="author"
              type="text"
              value={form.author}
              onChange={handleChange}
              className={inputClass('author')}
              placeholder="Author"
            />

            <label
              htmlFor="author"
              className="absolute left-3 -top-2.5 bg-slate-950 px-2 text-sm text-slate-400"
            >
              Author
            </label>

            {errors.author && (
              <p className="error-message mt-2 text-sm text-red-400">
                {errors.author}
              </p>
            )}
          </div>

          {/* ISBN */}
          <div className="relative">
            <input
              id="isbn"
              name="isbn"
              type="text"
              value={form.isbn}
              onChange={handleChange}
              className={inputClass('isbn')}
              placeholder="ISBN"
            />

            <label
              htmlFor="isbn"
              className="absolute left-3 -top-2.5 bg-slate-950 px-2 text-sm text-slate-400"
            >
              ISBN / Book ID
            </label>

            {errors.isbn && (
              <p className="error-message mt-2 text-sm text-red-400">
                {errors.isbn}
              </p>
            )}
          </div>

          {/* Category */}
          <div className="relative">
            <select
              id="category"
              name="category"
              value={form.category}
              onChange={handleChange}
              className={`w-full appearance-none rounded-xl bg-slate-900 border ${
                errors.category
                  ? 'border-red-500/60'
                  : 'border-white/10'
              } px-4 py-4 text-white outline-none focus:border-purple-500/70 focus:ring-4 focus:ring-purple-500/10`}
            >
              <option value="" className="bg-slate-900 text-white">
                Select category
              </option>

              {categories.map((category) => (
                <option
                  key={category}
                  value={category}
                  className="bg-slate-900 text-white"
                >
                  {category}
                </option>
              ))}
            </select>

            <label
              htmlFor="category"
              className="absolute left-3 -top-2.5 bg-slate-950 px-2 text-sm text-slate-400"
            >
              Category
            </label>

            {errors.category && (
              <p className="error-message mt-2 text-sm text-red-400">
                {errors.category}
              </p>
            )}
          </div>

          {/* Copies */}
          <div className="relative">
            <input
              id="quantity"
              name="quantity"
              type="number"
              min="1"
              value={form.quantity}
              onChange={handleChange}
              className={inputClass('quantity')}
              placeholder="Quantity"
            />

            <label
              htmlFor="quantity"
              className="absolute left-3 -top-2.5 bg-slate-950 px-2 text-sm text-slate-400"
            >
              Total Copies
            </label>

            {errors.quantity && (
              <p className="error-message mt-2 text-sm text-red-400">
                {errors.quantity}
              </p>
            )}
          </div>

          {errors.general && (
            <div className="error-message rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-300">
              {errors.general}
            </div>
          )}

          <button
            type="submit"
            disabled={isSubmitting}
            className="w-full flex items-center justify-center gap-2 py-4 rounded-xl bg-gradient-to-r from-purple-500 to-cyan-500 text-white font-semibold hover:scale-[1.01] hover:shadow-xl hover:shadow-purple-500/10 transition-all duration-300 disabled:opacity-60 disabled:cursor-not-allowed"
          >
            {isSubmitting ? (
              <>
                <Loader2 className="w-5 h-5 animate-spin" />
                Adding...
              </>
            ) : (
              <>
                <Plus className="w-5 h-5" />
                Add Book
              </>
            )}
          </button>

        </div>
      </form>

      {isSuccess && (
        <div className="success-toast fixed bottom-6 right-6 z-[100] flex items-center gap-3 rounded-2xl border border-emerald-400/20 bg-slate-900/95 backdrop-blur-xl px-5 py-4 text-white shadow-2xl">
          <CheckCircle className="w-5 h-5 text-emerald-400" />
          Book added successfully.
        </div>
      )}
    </div>
  );
}
</file>

