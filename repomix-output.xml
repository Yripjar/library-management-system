            <p className="text-slate-400 mt-1">{book.author}</p>
            <p className="text-slate-500 text-sm mt-1">ISBN: {book.isbn}</p>
            <span className="inline-block mt-3 px-3 py-1 rounded-full bg-purple-500/20 text-purple-300 text-sm">
