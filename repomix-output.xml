                      className="w-full sm:w-64 bg-white/[0.04] border border-white/10 rounded-xl pl-10 pr-4 py-3 text-white placeholder-slate-600 outline-none focus:border-purple-500/50"
                    />
                  </div>

                  <select
                    value={statusFilter}
                    onChange={(e) =>
                      setStatusFilter(
                        e.target.value
                      )
                    }
                    className="bg-slate-900 border border-white/10 rounded-xl px-4 py-3 text-white"
                  >
                    <option value="">
