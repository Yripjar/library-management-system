import { useEffect, useMemo, useRef, useState } from 'react';
import api from '../api';
import gsap from 'gsap';

import {
  BookOpen,
  ArrowUpRight,
  CheckCircle,
  Clock,
  Download,
  User,
  Calendar,
  BadgeCheck,
  Library,
  Activity,
  Search,
  AlertTriangle,
} from 'lucide-react';

export default function Dashboard() {
  const [books, setBooks] = useState([]);
  const [transactions, setTransactions] = useState([]);
  const [statusFilter, setStatusFilter] = useState('');
  const [search, setSearch] = useState('');
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');

  const counterRefs = useRef([]);

  const fetchData = async () => {
    try {
      setLoading(true);
      setError('');

      const [booksResponse, transactionsResponse] =
        await Promise.all([
          api.get('/books'),
          api.get('/transactions'),
        ]);

      setBooks(booksResponse.data || []);
      setTransactions(
        transactionsResponse.data || []
      );
    } catch (err) {
      console.error(err);

      setError(
        err.response?.data?.message ||
          'Unable to load dashboard.'
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, []);

  const stats = useMemo(() => {
    const totalTitles = books.length;

    const totalCopies = books.reduce(
      (sum, book) =>
        sum + Number(book.totalCopies || 0),
      0
    );

    const availableCopies = books.reduce(
      (sum, book) =>
        sum + Number(book.availableCopies || 0),
      0
    );

    const issuedCopies =
      totalCopies - availableCopies;

    const overdue = transactions.filter(
      (transaction) =>
        transaction.status === 'issued' &&
        transaction.dueDate &&
        new Date(transaction.dueDate) < new Date()
    ).length;

    return {
      totalTitles,
      totalCopies,
      availableCopies,
      issuedCopies,
      overdue,
    };
  }, [books, transactions]);

  useEffect(() => {
    if (loading) return;

    const values = [
      stats.totalTitles,
      stats.issuedCopies,
      stats.availableCopies,
      stats.overdue,
    ];

    counterRefs.current.forEach(
      (element, index) => {
        if (!element) return;

        const obj = {
          value: 0,
        };

        gsap.to(obj, {
          value: values[index],
          duration: 1.3,
          delay: index * 0.08,
          ease: 'power3.out',
          onUpdate: () => {
            element.textContent =
              Math.floor(obj.value);
          },
        });
      }
    );
  }, [stats, loading]);

  const filteredTransactions =
    transactions.filter((transaction) => {
      const matchesStatus =
        !statusFilter ||
        transaction.status === statusFilter;

      const query =
        search.trim().toLowerCase();

      const matchesSearch =
        !query ||
        transaction.borrowerName
          ?.toLowerCase()
          .includes(query) ||
        transaction.book?.title
          ?.toLowerCase()
          .includes(query);

      return (
        matchesStatus &&
        matchesSearch
      );
    });

  const lastSevenDays = useMemo(() => {
    return Array.from(
      { length: 7 },
      (_, index) => {
        const date = new Date();

        date.setHours(0, 0, 0, 0);

        date.setDate(
          date.getDate() - (6 - index)
        );

        return date;
      }
    );
  }, []);

  const activityData = useMemo(() => {
    return lastSevenDays.map((date) => {
      const count = transactions.filter(
        (transaction) => {
          const transactionDate =
            new Date(
              transaction.issueTimestamp
            );

          return (
            transactionDate.getFullYear() ===
              date.getFullYear() &&
            transactionDate.getMonth() ===
              date.getMonth() &&
            transactionDate.getDate() ===
              date.getDate()
          );
        }
      ).length;

      return {
        label: date.toLocaleDateString(
          undefined,
          { weekday: 'short' }
        ),
        count,
      };
    });
  }, [lastSevenDays, transactions]);

  const maxActivity = Math.max(
    ...activityData.map(
      (day) => day.count
    ),
    1
  );

  const categories = useMemo(() => {
    const map = {};

    books.forEach((book) => {
      const category =
        book.category || 'Other';

      map[category] =
        (map[category] || 0) + 1;
    });

    return Object.entries(map)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 6);
  }, [books]);

  const exportCsv = async () => {
    try {
      const response = await api.get(
        '/transactions/export',
        {
          responseType: 'blob',
        }
      );

      const url =
        window.URL.createObjectURL(
          new Blob(
            [response.data],
            {
              type: 'text/csv',
            }
          )
        );

      const link =
        document.createElement('a');

      link.href = url;
      link.download =
        'transactions.csv';

      document.body.appendChild(link);
      link.click();
      link.remove();

      window.URL.revokeObjectURL(url);
    } catch (err) {
      console.error(err);
      alert('Export failed.');
    }
  };

  const availabilityPercent =
    stats.totalCopies > 0
      ? Math.round(
          (stats.availableCopies /
            stats.totalCopies) *
            100
        )
      : 0;

  return (
    <div className="relative max-w-7xl mx-auto px-6 py-14">

      <div className="pointer-events-none absolute -top-32 -left-40 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-3xl" />

      {/* Header */}
      <div className="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10">

        <div>
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-300 text-sm mb-4">
            <Activity className="w-4 h-4" />
            Live Library Overview
          </div>

          <h1 className="text-5xl font-black tracking-tight">
            Dashboard
          </h1>

          <p className="mt-3 text-lg text-slate-500">
            Your entire library, in one view.
          </p>
        </div>

        <button
          onClick={exportCsv}
          className="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white/[0.04] border border-white/10 text-slate-200 hover:bg-white/[0.08] transition-all"
        >
          <Download className="w-5 h-5" />
          Export Transactions
        </button>

      </div>

      {error && (
        <div className="mb-8 rounded-2xl border border-red-500/20 bg-red-500/10 px-5 py-4 text-red-300">
          {error}
        </div>
      )}

      {loading ? (
        <div className="py-32 flex justify-center">
          <div className="w-12 h-12 rounded-full border-4 border-purple-500/20 border-t-purple-500 animate-spin" />
        </div>
      ) : (
        <>
          {/* Stats */}
          <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">

            <StatCard
              label="Total Titles"
              value={stats.totalTitles}
              icon={Library}
              refCallback={(el) =>
                (counterRefs.current[0] =
                  el)
              }
              theme="purple"
            />

            <StatCard
              label="Issued Copies"
              value={stats.issuedCopies}
              icon={ArrowUpRight}
              refCallback={(el) =>
                (counterRefs.current[1] =
                  el)
              }
              theme="cyan"
            />

            <StatCard
              label="Available Copies"
              value={stats.availableCopies}
              icon={CheckCircle}
              refCallback={(el) =>
                (counterRefs.current[2] =
                  el)
              }
              theme="green"
            />

            <StatCard
              label="Overdue"
              value={stats.overdue}
              icon={Clock}
              refCallback={(el) =>
                (counterRefs.current[3] =
                  el)
              }
              theme="red"
            />

          </div>

          {/* Main analytics */}
          <div className="grid xl:grid-cols-3 gap-6 mt-6">

            {/* Chart */}
            <div className="xl:col-span-2 rounded-3xl border border-white/[0.08] bg-white/[0.035] backdrop-blur-xl p-7">

              <div className="flex items-center justify-between mb-8">
                <div>
                  <h2 className="text-xl font-bold">
                    Borrowing Activity
                  </h2>
                  <p className="mt-1 text-sm text-slate-600">
                    Issues across the last seven days.
                  </p>
                </div>

                <div className="p-3 rounded-xl bg-purple-500/10 text-purple-400">
                  <Activity />
                </div>
              </div>

              <div className="h-64 flex items-end gap-3 md:gap-5">

                {activityData.map(
                  (day) => (
                    <div
                      key={day.label}
                      className="flex-1 h-full flex flex-col items-center justify-end gap-3"
                    >
                      <span className="text-xs text-slate-500">
                        {day.count}
                      </span>

                      <div className="w-full h-48 flex items-end">
                        <div
                          className="w-full rounded-t-xl bg-gradient-to-t from-purple-600 to-cyan-400 transition-all duration-700"
                          style={{
                            height: `${
                              Math.max(
                                day.count /
                                  maxActivity *
                                  100,
                                day.count > 0
                                  ? 8
                                  : 3
                              )
                            }%`,
                          }}
                        />
                      </div>

                      <span className="text-xs text-slate-600">
                        {day.label}
                      </span>
                    </div>
                  )
                )}

              </div>
            </div>

            {/* Availability */}
            <div className="rounded-3xl border border-white/[0.08] bg-white/[0.035] backdrop-blur-xl p-7">

              <div className="flex justify-between">
                <div>
                  <h2 className="text-xl font-bold">
