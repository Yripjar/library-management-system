          y: 20,
          opacity: 0,
          duration: 0.7,
        }, '-=0.5')
        .from('.hero-actions', {
          y: 20,
          opacity: 0,
          scale: 0.97,
          duration: 0.7,
        }, '-=0.4')
        .from('.hero-scroll', {
          opacity: 0,
          duration: 0.5,
        }, '-=0.2');

      gsap.to(videoRef.current, {
        scale: 1.14,
        filter: 'brightness(0.48) saturate(1.1)',
        scrollTrigger: {
          trigger: storyRef.current,
          start: 'top top',
          end: '+=100%',
          scrub: 1,
        },
      });

      gsap.to(heroCopyRef.current, {
        y: -160,
        opacity: 0,
        scale: 0.92,
        scrollTrigger: {
          trigger: storyRef.current,
          start: 'top top',
          end: '+=75%',
          scrub: 1,
        },
      });

      gsap.to(leftDoorRef.current, {
        xPercent: -100,
        scrollTrigger: {
          trigger: storyRef.current,
          start: 'top top',
          end: '+=80%',
          scrub: 1,
        },
      });

      gsap.to(rightDoorRef.current, {
        xPercent: 100,
        scrollTrigger: {
          trigger: storyRef.current,
          start: 'top top',
          end: '+=80%',
          scrub: 1,
